#!/bin/bash
# Host wrapper. stdin is /dev/null so OpenCode run does not block on an
# inherited pipe (upstream starts it with no stdin= argument).
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
source "$HERE/env.sh"
REAL=${HARNESS2_REAL_BUN:-$W/tmp/harness2/dependencies/tools/node_modules/.bin/bun}
# Trace is opt-in. start/end wrap the sandbox so a caller can see overlapping
# bun processes. exec would drop the end line, so the shell waits and exits.
if [[ -n "${HARNESS2_BUN_TRACE:-}" ]]; then
  mkdir -p "$(dirname "$HARNESS2_BUN_TRACE")"
  printf 'start %s %s\n' "$$" "$(date +%s%N)" >> "$HARNESS2_BUN_TRACE"
fi
extra=()
if [[ -n "${HARNESS2_HELDOUT:-}" ]]; then
  extra+=(--heldout "$HARNESS2_HELDOUT")
elif [[ -n "${HARNESS2_RUNS_DIR:-}" ]]; then
  extra+=(--runs "$HARNESS2_RUNS_DIR")
fi
if [[ -n "${HARNESS2_HARNESS:-}" ]]; then
  extra+=(--harness "$HARNESS2_HARNESS")
fi
if [[ -n "${HARNESS2_STATE:-}" ]]; then
  extra+=(--state "$HARNESS2_STATE")
fi
if [[ -n "${HARNESS2_PY312:-}" ]]; then
  extra+=(--py312 "$HARNESS2_PY312")
fi
# Same source as write_opencode_config: HARNESS2_RELAY_PORT. Unknown means
# there is no listener and the call would sit until the wall clock.
if ! port=$(python3 "$HERE/common.py" relay-port); then
  exit 2
fi
extra+=(--expose "$port" --allow "$port")
if [[ -n "${HARNESS2_BUN_TRACE:-}" ]]; then
  # The trace needs a line after the call, so this path cannot exec.
  set +e
  python3 "$HERE/sandbox.py" --real-bun "$REAL" "${extra[@]}" -- "$@" </dev/null
  rc=$?
  set -e
  printf 'end %s %s\n' "$$" "$(date +%s%N)" >> "$HARNESS2_BUN_TRACE"
  exit "$rc"
fi
# Replace this shell. A proposer SIGKILL hits this pid, which is the sandbox,
# and the relay (PDEATHSIG) and bwrap (--die-with-parent) die with it.
exec python3 "$HERE/sandbox.py" --real-bun "$REAL" "${extra[@]}" -- "$@" </dev/null
