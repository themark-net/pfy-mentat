#!/bin/bash
# Host wrapper. stdin is /dev/null so OpenCode run does not block on an
# inherited pipe (upstream starts it with no stdin= argument).
set -euo pipefail
HERE=$(cd "$(dirname "$0")" && pwd)
# shellcheck disable=SC1091
source "$HERE/env.sh"
REAL=${HARNESS2_REAL_BUN:-$W/tmp/harness2/dependencies/tools/node_modules/.bin/bun}
exec python3 "$HERE/sandbox.py" --real-bun "$REAL" -- "$@" </dev/null
