.env
.env.local
**/.env
**/__pycache__/
*.pyc
.DS_Store

# never commit cage-imported auth
**/.agentcage/**

# Lab receipts — regenerated by make smoke-* / eval-*; do not block cage-code-sync
pipelines/**/results.latest.md
pipelines/eval/structural.latest.md

# Cage project MCP preset (generated by workspace-sync / grok-mcp-preset)
.grok/config.toml

# OpenCode generated smoke config + skill symlinks
examples/opencode-ollama/.generated/
.opencode/

# Voice STT edge artifacts (transcripts, mic captures, handoff)
examples/voice-stt-edge/.generated/
# Local Whisper venv (make voice-stt-install) — never commit
examples/voice-stt-edge/.venv/
examples/voice-stt-edge/.venv-python-path

# Native GUI (Tauri 2 build artifacts)
gui/operator/src-tauri/target/
gui/operator/node_modules/
gui/operator/src-tauri/gen/

# Session workspace artifacts (Attach OpenCode / Space Invaders)
/workspace/

# Local doctrine-port inputs. SoT is bootstrap/grok-cli/skills/ — do not commit these.
/_port_sources/
tmp/

# Local env backups — never commit (includes .env.bak)
*.bak

# Generated/scratch expanded pfy — SoT is scripts/pfy
scripts/.pfy.expanded.sh

# Dogfood build isolated GROK_HOME (auth.json + grok rehydrate) — never commit
pipelines/dogfood/build/**/grok-home/

# Laya eval-auto trial (Entry 086) — venv + Hugging Face weights, never commit
.venv-laya/
.hf-cache/
pipelines/dogfood/laya-trial/laya-serve.log
pipelines/dogfood/laya-shadow/laya-serve.log

# Local-inference bench (Entry 089) — noisy per-model logs; keep receipt.json
pipelines/dogfood/local-bench/*.log
pipelines/dogfood/local-bench/*-cases.jsonl
