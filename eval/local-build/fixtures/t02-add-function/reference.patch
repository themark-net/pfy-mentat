+def slugify(text):
+    out = []
+    dash = False
+    for ch in text.strip().lower():
+        if ch.isalnum():
+            out.append(ch)
+            dash = False
+        elif not dash:
+            out.append("-")
+            dash = True
+    return "".join(out).strip("-")
