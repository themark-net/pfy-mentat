 def parse_duration(text):
-    raise NotImplementedError(text)
+    units = {"h": 3600, "m": 60, "s": 1}
+    total = 0
+    num = ""
+    for ch in text.strip():
+        if ch.isdigit():
+            num += ch
+            continue
+        if ch not in units or not num:
+            raise ValueError(text)
+        total += int(num) * units[ch]
+        num = ""
+    if num:
+        raise ValueError(text)
+    return total
