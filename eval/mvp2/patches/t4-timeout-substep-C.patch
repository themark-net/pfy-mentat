diff --git a/tests/test_mvp2_t4_timeout_step.py b/tests/test_mvp2_t4_timeout_step.py
new file mode 100644
index 0000000..c71ef83
--- /dev/null
+++ b/tests/test_mvp2_t4_timeout_step.py
@@ -0,0 +1,95 @@
+"""Acceptance test for t4. Already in the tree. Do not edit this file.
+
+A timeout on overtime `new` must record `new timeout after 0.4s`.
+A timeout on festival `fest --version` must record `version timeout after 0.4s`.
+Both exit 1. The entry name alone is not enough.
+"""
+from __future__ import annotations
+
+import hashlib
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _write_exe(path: Path, body: str) -> None:
+    path.write_text(body, encoding="utf-8")
+    path.chmod(0o755)
+
+
+def _run(entry: str, env: dict[str, str]) -> subprocess.CompletedProcess[str]:
+    return subprocess.run(
+        [sys.executable, "examples/x-intake-local/smoke_112_114.py", "--entry", entry],
+        cwd=str(ROOT), env=env, capture_output=True, text=True, timeout=60,
+    )
+
+
+class TimeoutSubstepTests(unittest.TestCase):
+    def test_overtime_new_timeout_names_new(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="mvp2-t4-ot-") as td:
+            root = Path(td)
+            home = root / "home"
+            home.mkdir()
+            pkg = root / "overtime-pkg" / "node_modules" / "@ukanwat" / "overtime"
+            (pkg / "dist").mkdir(parents=True)
+            (pkg / "dist" / "bin.js").write_text("// stub\n", encoding="utf-8")
+            (pkg / "package.json").write_text('{"version": "0.5.3"}\n', encoding="utf-8")
+            node = root / "node-stub"
+            _write_exe(node, "#!/bin/sh\nif [ \"$1\" = --version ]; then echo v22.19.0; exit 0; fi\nsleep 30\n")
+            receipts = root / "receipts"
+            env = os.environ.copy()
+            env.update({
+                "HOME": str(home),
+                "TMPDIR": str(root),
+                "OVERTIME_DIR": str(root / "overtime-pkg"),
+                "OVERTIME_NODE": str(node),
+                "PFY_XINTAKE_TIMEOUT": "0.4",
+                "PFY_SMOKE_RECEIPT_DIR": str(receipts),
+            })
+            proc = _run("overtime", env)
+            blob = proc.stdout + proc.stderr
+            self.assertNotIn("Traceback", proc.stderr, blob)
+            self.assertEqual(proc.returncode, 1, blob)
+            reason = json.loads((receipts / "overtime" / "latest.json").read_text(encoding="utf-8")).get("reason")
+            self.assertEqual(reason, "new timeout after 0.4s", blob)
+
+    def test_festival_version_timeout_names_version(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="mvp2-t4-fest-") as td:
+            root = Path(td)
+            home = root / "home"
+            home.mkdir()
+            body = "#!/bin/sh\nsleep 30\n"
+            fest, camp = root / "fest", root / "camp"
+            _write_exe(fest, body)
+            _write_exe(camp, body)
+
+            def digest(path: Path) -> str:
+                return hashlib.sha256(path.read_bytes()).hexdigest()
+
+            receipts = root / "receipts"
+            env = os.environ.copy()
+            env.update({
+                "HOME": str(home),
+                "TMPDIR": str(root),
+                "FEST_BIN": str(fest),
+                "FEST_SHA256": digest(fest),
+                "CAMP_SHA256": digest(camp),
+                "PFY_XINTAKE_TIMEOUT": "0.4",
+                "PFY_SMOKE_RECEIPT_DIR": str(receipts),
+            })
+            proc = _run("festival", env)
+            blob = proc.stdout + proc.stderr
+            self.assertNotIn("Traceback", proc.stderr, blob)
+            self.assertEqual(proc.returncode, 1, blob)
+            reason = json.loads((receipts / "festival" / "latest.json").read_text(encoding="utf-8")).get("reason")
+            self.assertEqual(reason, "version timeout after 0.4s", blob)
+
+
+if __name__ == "__main__":
+    unittest.main()
