diff --git a/tests/test_mvp2_t2_tree_sig_119.py b/tests/test_mvp2_t2_tree_sig_119.py
new file mode 100644
index 0000000..580674e
--- /dev/null
+++ b/tests/test_mvp2_t2_tree_sig_119.py
@@ -0,0 +1,50 @@
+"""Acceptance test for t2. Already in the tree. Do not edit this file.
+
+tree_sig in smoke_119_121.py must follow the content hash in smoke_122_124.py:
+a same-size edit that restores mtime changes the signature, and an mtime-only
+touch does not.
+"""
+from __future__ import annotations
+
+import importlib.util
+import os
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+
+
+def _tree_sig():
+    local = ROOT / "examples" / "x-intake-local"
+    if str(local) not in sys.path:
+        sys.path.insert(0, str(local))
+    spec = importlib.util.spec_from_file_location(
+        "mvp2_t2_smoke_119", local / "smoke_119_121.py",
+    )
+    module = importlib.util.module_from_spec(spec)
+    assert spec is not None and spec.loader is not None
+    spec.loader.exec_module(module)
+    return module.tree_sig
+
+
+class TreeSig119Tests(unittest.TestCase):
+    def test_content_not_mtime(self) -> None:
+        tree_sig = _tree_sig()
+        self.assertIsNone(tree_sig(Path("/this/path/is/not/on/disk/mvp2-t2")))
+        with tempfile.TemporaryDirectory(prefix="mvp2-t2-") as td:
+            root = Path(td)
+            target = root / "note.txt"
+            target.write_text("hello", encoding="utf-8")
+            before = tree_sig(root)
+            stamp = target.stat().st_mtime_ns
+            os.utime(target, ns=(stamp + 10**9, stamp + 10**9))
+            self.assertEqual(tree_sig(root), before, "mtime-only touch changed the signature")
+            target.write_text("hellp", encoding="utf-8")
+            os.utime(target, ns=(stamp, stamp))
+            self.assertNotEqual(tree_sig(root), before, "same-size edit with restored mtime was invisible")
+
+
+if __name__ == "__main__":
+    unittest.main()
