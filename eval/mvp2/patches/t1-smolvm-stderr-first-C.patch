diff --git a/tests/test_mvp2_t1_smolvm_evidence.py b/tests/test_mvp2_t1_smolvm_evidence.py
new file mode 100644
index 0000000..0188b01
--- /dev/null
+++ b/tests/test_mvp2_t1_smolvm_evidence.py
@@ -0,0 +1,41 @@
+"""Acceptance test for t1. Already in the tree. Do not edit this file.
+
+When stdout has a cache line and stderr has a Pulling image line for the same
+ref, smolvm_image_evidence must return the stderr line. A cache line alone
+still returns that cache line.
+"""
+from __future__ import annotations
+
+import importlib.util
+import sys
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+IMAGE = "alpine@sha256:" + ("ab" * 32)
+CACHE = "Caching image 0123456789abcdef (one-time; reused on later runs)"
+
+
+def _evidence():
+    local = ROOT / "examples" / "x-intake-local"
+    if str(local) not in sys.path:
+        sys.path.insert(0, str(local))
+    spec = importlib.util.spec_from_file_location(
+        "mvp2_t1_smoke_109", local / "smoke_109_111.py",
+    )
+    module = importlib.util.module_from_spec(spec)
+    assert spec is not None and spec.loader is not None
+    spec.loader.exec_module(module)
+    return module.smolvm_image_evidence
+
+
+class SmolvmEvidenceTests(unittest.TestCase):
+    def test_stderr_pull_wins_and_cache_only_still_works(self) -> None:
+        evidence = _evidence()
+        self.assertEqual(evidence(CACHE + "\n", "", IMAGE), CACHE)
+        stderr = "Pulling image " + IMAGE + "...\n"
+        self.assertEqual(evidence(CACHE + "\n", stderr, IMAGE), "Pulling image " + IMAGE + "...")
+
+
+if __name__ == "__main__":
+    unittest.main()
