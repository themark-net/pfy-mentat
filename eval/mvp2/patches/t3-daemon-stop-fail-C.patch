diff --git a/tests/test_mvp2_t3_daemon_stop.py b/tests/test_mvp2_t3_daemon_stop.py
new file mode 100644
index 0000000..facf395
--- /dev/null
+++ b/tests/test_mvp2_t3_daemon_stop.py
@@ -0,0 +1,86 @@
+"""Acceptance test for t3. Already in the tree. Do not edit this file.
+
+When `daemon stop` times out and no overtimed.lock exists, the overtime smoke
+must exit 1. The receipt reason must be the shared timeout text for that step,
+not the success sentence that says the daemon stopped.
+"""
+from __future__ import annotations
+
+import json
+import os
+import subprocess
+import sys
+import tempfile
+import unittest
+from pathlib import Path
+
+ROOT = Path(__file__).resolve().parents[1]
+STUB = r"""#!/bin/sh
+if [ "$1" = --version ]; then echo v22.19.0; exit 0; fi
+sub=$2
+agent="$HOME/overtime/agents/smoke-agent"
+case "$sub" in
+  new)
+    mkdir -p "$agent/.overtime"
+    printf 'dailyBudgetUsd: 1\n' > "$agent/AGENT.md"
+    printf '%s\n' '{"dailyBudgetUsd": 1, "protect": []}' > "$agent/.overtime/settings.json"
+    printf '%s\n' '{"status": "idle"}' > "$agent/.overtime/state.json"
+    ;;
+  ls) echo smoke-agent ;;
+  set)
+    prot=${5#protect=}
+    printf '%s\n' "$prot" > "$agent/.overtime/prot"
+    printf '%s\n' "{\"dailyBudgetUsd\": 1, \"protect\": [\"$prot\"]}" > "$agent/.overtime/settings.json"
+    setsid sh -c "sleep 0.2; printf '%s\n' '{\"dailyBudgetUsd\": 999}' > \"$agent/.overtime/settings.json\"" >/dev/null 2>&1 &
+    ;;
+  settings)
+    prot=$(cat "$agent/.overtime/prot")
+    echo "\$1 a day $prot"
+    ;;
+  daemon) sleep 30 ;;
+esac
+exit 0
+"""
+
+
+def _write_exe(path: Path, body: str) -> None:
+    path.write_text(body, encoding="utf-8")
+    path.chmod(0o755)
+
+
+class DaemonStopTimeoutTests(unittest.TestCase):
+    def test_stop_timeout_without_lock_is_fail(self) -> None:
+        with tempfile.TemporaryDirectory(prefix="mvp2-t3-") as td:
+            root = Path(td)
+            home = root / "home"
+            home.mkdir()
+            pkg = root / "overtime-pkg" / "node_modules" / "@ukanwat" / "overtime"
+            (pkg / "dist").mkdir(parents=True)
+            (pkg / "dist" / "bin.js").write_text("// stub\n", encoding="utf-8")
+            (pkg / "package.json").write_text('{"version": "0.5.3"}\n', encoding="utf-8")
+            node = root / "node-stub"
+            _write_exe(node, STUB)
+            receipts = root / "receipts"
+            env = os.environ.copy()
+            env["HOME"] = str(home)
+            env["TMPDIR"] = str(root)
+            env["OVERTIME_DIR"] = str(root / "overtime-pkg")
+            env["OVERTIME_NODE"] = str(node)
+            env["PFY_XINTAKE_TIMEOUT"] = "0.4"
+            env["PFY_SMOKE_RECEIPT_DIR"] = str(receipts)
+            for key in ("OVERTIME_VERSION", "FEST_BIN", "FEST_SHA256", "CAMP_SHA256", "SLOPTRIM_DIR", "SLOPTRIM_COMMIT"):
+                env.pop(key, None)
+            proc = subprocess.run(
+                [sys.executable, "examples/x-intake-local/smoke_112_114.py", "--entry", "overtime"],
+                cwd=str(ROOT), env=env, capture_output=True, text=True, timeout=60,
+            )
+            blob = proc.stdout + proc.stderr
+            self.assertNotIn("Traceback", proc.stderr, blob)
+            self.assertEqual(proc.returncode, 1, blob)
+            receipt = json.loads((receipts / "overtime" / "latest.json").read_text(encoding="utf-8"))
+            self.assertEqual(receipt.get("reason"), "overtime daemon stop timeout after 0.4s", blob)
+            self.assertNotIn("daemon stopped", receipt.get("reason") or "", blob)
+
+
+if __name__ == "__main__":
+    unittest.main()
