# Copy to repo-root .env (gitignored):  make env-init
# Never commit real secrets.

# --- Deployment profile ---
# local-only | balanced | max-performance
DEPLOY_PROFILE=balanced

# --- Agent cage ---
AGENTCAGE_DIR=${HOME}/.agentcage

# --- Grok Build auth ---
# Primary (interactive / subscription): browser or device OIDC → ~/.grok/auth.json
#   Host:  grok login
#   Cage:  make cage-grok-auth-import   # copies auth.json into ~/.agentcage/grok-home/
#      or: inside cage → grok login --device-auth
# Optional API key fallback (console.x.ai) — only if no auth.json session:
# XAI_API_KEY=

# --- Local inference ---
OLLAMA_HOST=http://127.0.0.1:11434
OPENAI_BASE_URL=http://127.0.0.1:11434/v1
# From inside agent-cage (see examples/litellm-ollama/host-ollama-gateway.sh):
# OLLAMA_HOST=http://host.docker.internal:11435
# OPENAI_BASE_URL=http://host.docker.internal:11435/v1
# LITELLM_SMOKE_MODEL=deepseek-coder:latest

# --- LiteLLM (T-0012 profiles) ---
# LITELLM_CONFIG=config/litellm/local-only.yaml   # or balanced.yaml / max-performance.yaml
# OLLAMA_API_BASE=http://127.0.0.1:11434          # host; cage: http://host.docker.internal:11435
# LITELLM_CLOUD_MODEL=xai/grok-3                  # balanced / max-performance
# LITELLM_MASTER_KEY=                             # only if exposing a shared proxy

# --- Optional cloud fallbacks (secret) ---
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# --- Write-guard MCP (planned) ---
WRITE_GUARD_MODE=audit
WRITE_GUARD_ROOTS=/workspace

# --- Optional ---
# HF_TOKEN=
# GITHUB_TOKEN=

# --- OpenContext (oc) knowledge handoff (#205) ---
# OPENCONTEXT_CONTEXTS_ROOT=${HOME}/.opencontext/contexts
# OPENCONTEXT_DB_PATH=${HOME}/.opencontext/opencontext.db
# Prove: ./pfy context   (FAIL if node/oc missing: npm install -g @aicontextlab/cli)

# --- Attach mode (#208 / #213) ---
# PFY_ATTACH_MODE=bare
# bare | orchestration | code-graph  (one at a time; unwired = FAIL+next)
# orchestration Attach starts a multi-step local loop (not thin skill inject)
# PFY_LOOP_CARD=$HOME/.pfy-mentat/loop-card.md
# PFY_LOOP_EVIDENCE=$HOME/.pfy-mentat/loop-evidence.json
# PFY_GRAPH_PATH=axon   # or codebase-memory (never claim axon on MCP-only)
# Prove: ./pfy code-graph   (FAIL if neither axon nor codebase-memory-mcp)

# --- Recommend / try local models (#207) ---
# ./pfy models recommend | try [name]
# pin lives in $PFY_STATE_DIR/pinned-model (FreeToken also ft-model)

# --- Catalog ask / queue (#209) + live org queue (#214) ---
# ./pfy catalog | catalog ask <name> | catalog queue <name> | catalog status
# PFY_CATALOG_ASK_PROMPT=$HOME/.pfy-mentat/catalog-ask-prompt.md
# Queue uses gh auth or GITHUB_TOKEN/GH_TOKEN (FAIL if both missing)

# --- Gab.ai cloud lane + local recommend sync (#228) ---
# GAB_API_KEY=                         # Plus/max plan · https://gab.ai/docs/api-auth
# PFY_GAB_MODEL=auto                   # cloud router default; or pin id from GET /v1/models
# PFY_GAB_OFFLINE=1                    # CI / offline: use scripts/fixtures/gab_models_v1.json
# Honesty: gab auto ≠ local ranking; Gab does not host GGUF — we pull open-weight families to Ollama

# --- Jev-style decision layer (#230) ---
# TYPESAFE_API_KEY=                    # optional cloud; never required for smoke
# PFY_JEV_MODEL=jev-1.13.0
# PFY_JEV_CONF_GATE=0.85               # margin gate; conf low → FAIL, not silent auto-act
# PFY_JEV_OFFLINE=1                    # CI: no TypeSafe network
# Primary local: CUA-S1-FORMS (./pfy decision smoke). mini-jev = teaching fallback.
# Honesty: decision ≠ gab auto ≠ local
