{
  "version": "1.2",
  "last_updated": "2026-07-30",
  "description": "Automated evaluation lanes for design/coding assist. Structural never requires LLM. Golden validate is deterministic; LLM replay still optional later.",
  "lanes": [
    {
      "id": "structural",
      "requires_llm": false,
      "command": "make eval-structural",
      "artifacts": ["pipelines/eval/structural.latest.md"],
      "purpose": "Skills, tools.json schema, text-scorer fixtures, design/coding SKILL.md presence, golden-task cards"
    },
    {
      "id": "connectivity",
      "requires_llm": false,
      "requires_backend": "ollama+litellm_gateway",
      "command": "make eval-tier0",
      "purpose": "LiteLLM → Ollama path alive"
    },
    {
      "id": "implement",
      "requires_llm": true,
      "requires_backend": "ollama",
      "command": "make eval-suite",
      "gate_model_env": "EVAL_MODEL",
      "default_gate_model": "qwen2.5:14b",
      "purpose": "Model coding tasks with hidden tests (001, 002)"
    },
    {
      "id": "matrix",
      "requires_llm": true,
      "requires_backend": "ollama",
      "command": "make eval-matrix",
      "purpose": "Multi-model observational table; missing models SKIP"
    },
    {
      "id": "golden_replay",
      "requires_llm": false,
      "status": "active_deterministic",
      "command": "make eval-golden",
      "artifacts": ["data/golden-tasks/", "pipelines/eval/golden.latest.md"],
      "purpose": "Validate golden-task cards (schema + acceptance_checks). LLM agent replay deferred.",
      "notes": "Also invoked from eval-structural golden_tasks check"
    }
  ],
  "task_kinds": [
    {
      "kind": "implement",
      "required_files": ["prompt.txt", "test_task.py"],
      "in_default_suite": true
    },
    {
      "kind": "text_scorer",
      "required_files": ["score.py", "fixtures/pass*", "fixtures/fail*"],
      "in_default_suite": false,
      "in_structural": true
    },
    {
      "kind": "golden_card",
      "required_files": ["data/golden-tasks/GT-*.json"],
      "in_default_suite": false,
      "in_golden_replay": true
    }
  ],
  "model_pool": {
    "max_weights_gb": 250,
    "policy_doc": "docs/ops/local-model-storage-and-eval.md",
    "never_commit_weights": true,
    "prefer_concurrent_minis": true
  }
}
