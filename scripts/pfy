#!/usr/bin/env bash
# pfy — simple operator surface for pfy-mentat
# Inference first (FreeToken / llama-swap / llama-server / Ollama), then native operator window.
# Named ./pfy start <harness> still execs that harness. Bare ./pfy does not exec a harness.
# Plain source. Do not re-encode or shard this file (gate: scripts/check_no_encoded_payloads.py).
set -euo pipefail
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [[ -L "$SCRIPT_PATH" ]]; do
  link="$(readlink "$SCRIPT_PATH")"
  if [[ "$link" != /* ]]; then
    SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/$link"
  else
    SCRIPT_PATH="$link"
  fi
done
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
REG="$ROOT/data/harnesses.json"
DETECT="$ROOT/scripts/detect-local-runtime.sh"
STATE_DIR="${PFY_STATE_DIR:-$HOME/.pfy-mentat}"
ACTIVE_FILE="$STATE_DIR/active-harness"
mkdir -p "$STATE_DIR"

die() { echo "error: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

board_url() {
  echo "http://127.0.0.1:${PFY_BOARD_PORT:-8765}"
}

print_board_url() {
  echo "board: $(board_url)"
}

open_board_url() {
  local url
  url="$(board_url)"
  if have xdg-open; then
    xdg-open "$url" >/dev/null 2>&1 && return 0
  elif have open; then
    open "$url" >/dev/null 2>&1 && return 0
  fi
  echo "note: could not open browser - $url"
  return 0
}

tauri_bin() {
  # Fresh only: not older than frontend HTML, and contains run_stage.
  # Stale leftover binaries must not win. Never print a rebuild one-liner.
  local html="$ROOT/gui/operator/frontend/index.html"
  local cands=(
    "$ROOT/gui/operator/src-tauri/target/release/pfy-operator"
    "$ROOT/gui/operator/src-tauri/target/debug/pfy-operator"
  )
  local b
  for b in "${cands[@]}"; do
    [[ -x "$b" ]] || continue
    if [[ -f "$html" && "$b" -ot "$html" ]]; then
      continue
    fi
    if ! grep -a -F -q "run_stage" "$b" 2>/dev/null; then
      continue
    fi

    if ! grep -a -F -q "launch_env" "$b" 2>/dev/null; then
      continue
    fi
    echo "$b"
    return 0
  done
  return 1
}

warn_if_active_stub() {
  local preferred
  preferred="$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)"
  [[ -n "$preferred" ]] || preferred="grok"
  case "$preferred" in
    continue|agent-cage)
      echo "FAIL: active harness is $preferred — no grok/opencode fallback"
      echo "  pfy harness use grok"
      ;;
  esac
}

launch_native_gui() {
  local tbin
  tbin="$(tauri_bin || true)"
  if [[ -n "$tbin" ]]; then
    echo "native window (Tauri)"
    export PFY_ROOT="$ROOT"
    exec "$tbin"
  fi
  if [[ -f "$ROOT/scripts/pfy-gui.py" ]]; then
    # print native window (webkit|tk); never pywebview as product path
    exec python3 "$ROOT/scripts/pfy-gui.py"
  fi
  mkdir -p "$STATE_DIR"
  art="$STATE_DIR/gui-stopped-exit.txt"
  printf 'STOPPED_EXIT\nerror: scripts/pfy-gui.py missing\n' >"$art"
  echo "STOPPED_EXIT: scripts/pfy-gui.py missing" >&2
  echo "artifact: $art" >&2
  exit 1
}

cmd_gui() {
  # #191: surface ensure_inference FAIL in log; still open window (board Launch uses ./pfy env).
  ensure_inference || true
  run_product_stage || true
  warn_if_active_stub
  echo "native window is the main interface (no harness exec into this process)"
  echo "  Attach grok / opencode / hermes / codex / claude / gab from the window (sidecar). Decision: CUA-S1-FORMS / TypeSafe / mini-jev (#230). named: ./pfy start <harness>"
  launch_native_gui
}

usage() {
  cat <<'U'
pfy — simple setup & launch for the pfy-mentat stack

  pfy                     inference → env-stage → native operator window (no harness exec)
  pfy env                 inference + env-stage (no window, no harness exec)
  pfy setup [local-only|balanced|max-performance]
  pfy status              harness table + local usage block
  pfy usage               local usage only (engine/endpoint/models/tok_path/vram)
  pfy up                  same as bare pfy (native window; attach is in-window sidecar)
  pfy harness list|use <id>|show [id]
  pfy start [harness]     no name: same as bare pfy. named: exec that harness after inference/stage
  pfy stage [--lab]       env-stage; --lab optional personal cage lab (doctor→setup→up-mcp)
  pfy eval | ship
  pfy endpoint              print FreeToken-first live OpenAI-compat base (one line)
  pfy doctor               FreeToken-first one-shot health (detect+endpoint+tok/vram)
  pfy smoke                FreeToken-first models list + one chat smoke
  pfy context             prove oc capture/search/reuse (FAIL if node/oc missing)
  pfy code-graph          prove Axon (or codebase-memory equivalent) (#215)
  pfy axon                alias of code-graph
  attach mode             Attach: bare | orchestration | code-graph (using: <mode>; #208)
                          orchestration starts multi-step local loops (#213)
                          code-graph hands Axon or equivalent (#215)
  pfy models [list]       list FreeToken-first live engine models (inspect-only)
  pfy models pull <name>  live engine (FreeToken records name; Ollama pulls; llama skip)
  pfy models recommend    ranked host-fit models not yet pulled (VRAM/RAM/runtime)
  pfy models try [name]   pull top (or named) recommendation — operate-or-FAIL
  pfy models gab-sync     Gab open-weight → Ollama fit (#228; gab auto ≠ local ranking)
  pfy models gab-pull <tag> [--confirm] [--opt-in-huge]  gated ollama pull from Gab sync
  pfy catalog             usable catalog browse subset (not scores-only) (#209)
  pfy catalog ask [name]  ask attached TUI to implement for next launch
  pfy catalog queue [name] queue GitHub issue Design→DevBot (no Mark git/npm/CI)
  pfy catalog status      queued catalog items
  pfy launch              Launch session after Loop wizard compose (#225/#224)
  pfy launch lane|toolset|harness|decision|review|compose
  pfy decision            Jev-style typed Choice/Score (#230; CUA-S1-FORMS local)
  pfy decision off|cua-s1-forms|typesafe|mini-jev
  pfy decision smoke      Mark-free CUA-S1-FORMS Choice (no TypeSafe key)
  pfy toolset matrix      toolset × harness grid: implemented|partial|stub (ADR-0017; honest, most cells stub)
  pfy toolset list|plan <toolset> --harness <h> [--lane local|cloud] [--env|--brief]
  pfy toolset apply <toolset> --harness <h> [--yes]   dry-run unless --yes; writes only $PFY_STATE_DIR / harness home
  pfy hedge decide --task bulk|hard|interactive [--json]  local first; cloud only within PFY_CLOUD_BUDGET (credits)
  pfy hedge ledger [--reset] | hedge record <n>            $PFY_STATE_DIR/hedge-ledger.json
  pfy board [--open]      alias of the native operator window
                          --open is an optional hatch (not the main path)
  pfy help

Native window is the main interface. Tauri when the binary is current; else already-on-box webkit or stdlib tk (scripts/pfy-gui.py). pywebview is PFY_GUI_DEV=1 only. Window always opens.
Browser --open is not required. Board is not a supervisor.
Continue/agent-cage active: FAIL, copy `pfy harness use grok` (no fallback).

Inference detect: FreeToken (:1919) → llama-swap (:9292) → llama-server (:8080) → Ollama.
Override: PFY_LOCAL_RUNTIME, LOCAL_OPENAI_BASE_URL.
FreeToken model: PFY_FT_MODEL (then LOCAL_CODER_MODEL, FREETOKEN_MODEL).
Ollama adapter model: PFY_OLLAMA_MODEL (then LOCAL_CODER_MODEL).
llama-server model path: PFY_LLAMA_MODEL (then LOCAL_CODER_MODEL as a GGUF path).
Detector is invoked with bash (no git +x required).
Docker not required for basic start.
U
}

json_field() {
  python3 - "$REG" "$1" "${2:-}" <<'PY'
import json,sys
reg=json.load(open(sys.argv[1]))
cmd=sys.argv[2]
arg=sys.argv[3] if len(sys.argv)>3 else ""
if cmd=="list":
    for h in reg["harnesses"]:
        print(f"{h['id']}\t{h['status']}\t{h['role']}\t{h['name']}")
elif cmd=="default":
    print(reg.get("default_harness","grok"))
elif cmd=="get":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print(json.dumps(h, indent=2)); break
    else:
        sys.exit(1)
elif cmd=="detects":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print("\n".join(h.get("detect") or [])); break
elif cmd=="github_issue":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            gi=h.get("github_issue")
            print("" if gi in (None,"") else gi)
            break
    else:
        sys.exit(1)
elif cmd=="adapter_ids":
    for h in reg["harnesses"]:
        if h.get("role")=="harness":
            print(h["id"])
PY
}

local_runtime() {
  if [[ -f "$DETECT" ]]; then
    bash "$DETECT" --json
  else
    echo '{"engine":"none","status":"missing","base_url":""}'
  fi
}

rt_get() {
  python3 -c "import json,sys; print(json.loads(sys.argv[1]).get(sys.argv[2],'') or '')" "$1" "$2"
}

ft_bin() {
  if have ft; then echo ft
  elif have freetoken; then echo freetoken
  else echo ft
  fi
}

ft_recorded_model() {
  local f="${STATE_DIR}/ft-model" line=""
  [[ -f "$f" ]] || return 0
  IFS= read -r line <"$f" || true
  printf '%s' "$line"
}

ft_default_model() {
  local env_model recorded
  env_model="${PFY_FT_MODEL:-${LOCAL_CODER_MODEL:-${FREETOKEN_MODEL:-}}}"
  if [[ -n "$env_model" ]]; then
    printf '%s\n' "$env_model"
    return 0
  fi
  recorded="$(ft_recorded_model)"
  printf '%s\n' "$recorded"
}

record_ft_pull_model() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$STATE_DIR/ft-model"
}

ft_health() {
  curl -sf --max-time 2 http://127.0.0.1:1919/v1/models >/dev/null 2>&1 \
    || curl -sf --max-time 2 http://127.0.0.1:1919/health >/dev/null 2>&1
}

wait_freetoken_health() {
  local i
  for i in $(seq 1 12); do
    ft_health && return 0
    sleep 0.5
  done
  return 1
}

ensure_freetoken() {
  # #191: return 0 only when health probe passes — no stub-0 / partial-0 / skip-0.
  local bin model
  if ! have ft && ! have freetoken; then
    echo "STUB: FreeToken not on PATH. One-liner:"
    echo "  ft serve --model \$PFY_FT_MODEL"
    return 1
  fi
  bin="$(ft_bin)"
  if ft_health; then
    echo "FreeToken API healthy"
    return 0
  fi
  model="$(ft_default_model)"
  if [[ -z "$model" ]]; then
    echo "note: FreeToken has no model env (set PFY_FT_MODEL, or LOCAL_CODER_MODEL / FREETOKEN_MODEL) — honest skip"
    echo "  ft serve --model \$PFY_FT_MODEL"
    return 1
  fi
  echo "starting FreeToken in background (wait for /v1/models or /health on :1919)…"
  ("$bin" serve --model "$model" >>"$STATE_DIR/freetoken.log" 2>&1 &) || true
  if wait_freetoken_health; then
    echo "FreeToken API healthy"
    return 0
  fi
  echo "note: FreeToken launched but API not healthy (partial/timeout) — not fake ready"
  return 1
}

ollama_health() {
  curl -sf --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1 \
    || curl -sf --max-time 2 http://127.0.0.1:11434/v1/models >/dev/null 2>&1
}

wait_ollama_health() {
  local i
  for i in $(seq 1 12); do
    ollama_health && return 0
    sleep 0.5
  done
  return 1
}

ollama_default_model() {
  echo "${PFY_OLLAMA_MODEL:-${LOCAL_CODER_MODEL:-${OLLAMA_MODEL:-}}}"
}

ollama_has_model() {
  local name="${1:-}"
  [[ -z "$name" ]] && return 1
  ollama show "$name" >/dev/null 2>&1 && return 0
  ollama list 2>/dev/null | awk -v n="$name" 'NR>1 && $1!="" && index($1,n)==1 { found=1 } END { exit !found }'
}

ollama_any_model() {
  ollama list 2>/dev/null | awk 'NR>1 && $1!="" { found=1 } END { exit !found }'
}

ensure_ollama_adapter() {
  # #191: return 0 only when health probe passes (and a model is available) — no stub-0 / partial-0.
  if ! have ollama; then
    echo "STUB: ollama not on PATH. One-liner:"
    echo "  ollama serve"
    return 1
  fi
  if ollama_health; then
    echo "ollama API healthy"
  else
    echo "starting Ollama serve (wait for /api/tags or /v1/models)…"
    (ollama serve >>"$STATE_DIR/ollama.log" 2>&1 &) || true
    if wait_ollama_health; then
      echo "ollama API healthy"
    else
      echo "note: ollama serve launched but API not healthy (partial/timeout) — not fake ready"
      return 1
    fi
  fi
  local model
  model="$(ollama_default_model)"
  if [[ -n "$model" ]]; then
    if ollama_has_model "$model"; then
      echo "default model present: $model"
      return 0
    fi
    echo "pulling default model: $model"
    if ollama pull "$model"; then
      return 0
    fi
    echo "note: ollama pull failed — honest skip"
    return 1
  elif ollama_any_model; then
    echo "note: no PFY_OLLAMA_MODEL / LOCAL_CODER_MODEL — using already-installed tags"
    return 0
  fi
  echo "note: no PFY_OLLAMA_MODEL / LOCAL_CODER_MODEL and no models installed — honest skip"
  return 1
}


