#!/usr/bin/env bash
# pfy — simple operator surface for pfy-mentat
# Feel: Ollama then Hermes — one binary, inference first, harnesses attach.
set -euo pipefail
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
# resolve symlink so ./pfy → scripts/pfy still finds repo root
while [[ -L "$SCRIPT_PATH" ]]; do
  link="$(readlink "$SCRIPT_PATH")"
  if [[ "$link" != /* ]]; then
    SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/$link"
  else
    SCRIPT_PATH="$link"
  fi
done
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
REG="$ROOT/data/harnesses.json"
STATE_DIR="${PFY_STATE_DIR:-$HOME/.pfy-mentat}"
ACTIVE_FILE="$STATE_DIR/active-harness"
mkdir -p "$STATE_DIR"

# Pluggable inference (ADR-0014). Default remains Ollama adapter.
PFY_INFERENCE="${PFY_INFERENCE:-ollama}"

die() { echo "error: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

inference_url() {
  if [[ -n "${PFY_INFERENCE_URL:-}" ]]; then
    echo "${PFY_INFERENCE_URL%/}"
    return
  fi
  case "${PFY_INFERENCE:-ollama}" in
    shimmy) echo "http://127.0.0.1:11435/v1" ;;
    llama-swap) echo "http://127.0.0.1:8080/v1" ;;
    ollama|*) echo "http://127.0.0.1:11434/v1" ;;
  esac
}

# OpenAI-compat /v1/models (base URL may already include /v1)
openai_models_up() {
  local base="${1:-$(inference_url)}"
  base="${base%/}"
  curl -sf --max-time 2 "${base}/models" >/dev/null 2>&1
}

ollama_api_up() {
  curl -sf --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1 \
    || openai_models_up "http://127.0.0.1:11434/v1"
}

# Bounded wait (T-0101): a few seconds, not unbounded.
wait_http() {
  local n=0
  local max="${2:-5}"
  local check="$1"
  while [[ "$n" -lt "$max" ]]; do
    if $check; then return 0; fi
    sleep 1
    n=$((n + 1))
  done
  return 1
}

usage() {
  cat <<'U'
pfy — simple setup & launch for the pfy-mentat stack

  pfy setup [local-only|balanced|max-performance]
      One-shot: env + skills + detect tools (Ollama-style bootstrap)

  pfy status
      What is installed / ready / stub; live inference backend

  pfy harness list
  pfy harness use <id>
  pfy harness show [id]

  pfy start [harness]
      Ensure selected inference (PFY_INFERENCE) when possible, then launch harness
      Default harness = grok (monitor). Local worker = OpenAI-compat.

  pfy stage
      Green path: env-check + structural eval (+ soft Ollama)

  pfy eval
      Integration self-mod gates (catalog hygiene)

  pfy ship
      Product verify (+ optional push)

  pfy models pull <name>
      ollama pull wrapper

  pfy help

Env: PFY_INFERENCE=ollama|shimmy|llama-swap  PFY_INFERENCE_URL  OPENAI_BASE_URL
Philosophy: inference comes up once; harnesses (Grok, OpenCode, Hermes, …)
attach to it. Unfinished harnesses are stubs with a clear next issue — not
hidden Make targets. Engines are not vendored.
U
}

json_field() {
  python3 - "$REG" "$1" "${2:-}" <<'PY'
import json,sys
reg=json.load(open(sys.argv[1]))
cmd=sys.argv[2]
arg=sys.argv[3] if len(sys.argv)>3 else ""
if cmd=="list":
    for h in reg["harnesses"]:
        print(f"{h['id']}\t{h['status']}\t{h['role']}\t{h['name']}")
elif cmd=="default":
    print(reg.get("default_harness","grok"))
elif cmd=="inference_default":
    print(reg.get("inference_default","ollama"))
elif cmd=="get":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print(json.dumps(h, indent=2)); break
    else:
        sys.exit(1)
elif cmd=="detects":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print("\n".join(h.get("detect") or [])); break
elif cmd=="all":
    print(json.dumps(reg["harnesses"]))
PY
}

detect_status() {
  local id="$1"
  local status_reg
  status_reg=$(python3 -c "import json; d=json.load(open('$REG')); print(next(h['status'] for h in d['harnesses'] if h['id']=='$id'))")
  local bins
  bins=$(json_field detects "$id" || true)
  local found=0
  if [[ -n "$bins" ]]; then
    while IFS= read -r b; do
      [[ -z "$b" ]] && continue
      if [[ "$b" == "exo.sh" ]]; then
        [[ -x "$ROOT/exo.sh" || -x "$HOME/exo/exo.sh" ]] && found=1
      elif have "$b"; then
        found=1
      fi
    done <<< "$bins"
  fi
  if [[ "$id" == "ollama" ]]; then
    if ollama_api_up; then
      echo "ready"
    elif have ollama; then
      echo "partial"
    else
      echo "missing"
    fi
    return
  fi
  if [[ "$id" == "shimmy" ]]; then
    if openai_models_up "http://127.0.0.1:11435/v1"; then
      echo "ready"
    elif have shimmy; then
      echo "partial"
    else
      echo "missing"
    fi
    return
  fi
  if [[ "$id" == "llama-swap" ]]; then
    if openai_models_up "http://127.0.0.1:8080/v1"; then
      echo "ready"
    elif have llama-swap; then
      echo "partial"
    else
      echo "missing"
    fi
    return
  fi
  if [[ "$status_reg" == "stub" ]]; then
    if [[ "$found" -eq 1 ]]; then echo "detected-stub"; else echo "stub"; fi
    return
  fi
  if [[ "$found" -eq 1 ]]; then echo "ready"
  elif [[ "$status_reg" == "partial" ]]; then echo "partial"
  else echo "missing"
  fi
}

cmd_status() {
  local iurl
  iurl="$(inference_url)"
  echo "pfy-mentat simple surface"
  echo "root: $ROOT"
  echo "active harness: $(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)"
  echo "inference: PFY_INFERENCE=${PFY_INFERENCE}  url=${iurl}"
  if openai_models_up "$iurl"; then
    echo "inference live: openai-compat /v1/models OK"
  elif [[ "$PFY_INFERENCE" == "ollama" ]] && ollama_api_up; then
    echo "inference live: ollama /api/tags OK"
  else
    echo "inference live: down (not ready — will not fake)"
  fi
  echo ""
  printf "%-14s %-14s %-8s %s\n" "ID" "STATUS" "ROLE" "NAME"
  printf "%-14s %-14s %-8s %s\n" "----" "------" "----" "----"
  json_field list | while IFS=$'\t' read -r id st role name; do
    live=$(detect_status "$id")
    printf "%-14s %-14s %-8s %s\n" "$id" "$live" "$role" "$name"
  done
  echo ""
  echo "next: pfy setup   |   pfy start   |   pfy harness list"
}

cmd_setup() {
  local profile="${1:-balanced}"
  echo "==> pfy setup (profile=$profile)"
  (cd "$ROOT" && make env-init)
  if [[ -f "$ROOT/.env" ]]; then
    if grep -q '^DEPLOY_PROFILE=' "$ROOT/.env" 2>/dev/null; then
      sed -i.bak "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null \
        || sed -i '' "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null || true
    else
      echo "DEPLOY_PROFILE=$profile" >> "$ROOT/.env"
    fi
  fi
  if have grok || [[ -x "$HOME/.local/bin/grok" ]]; then
    echo "==> Grok CLI found — installing skills"
    bash "$ROOT/bootstrap/grok-cli/install.sh" || echo "warn: grok install had issues"
  else
    echo "note: Grok CLI not on PATH — install: curl -fsSL https://x.ai/cli/install.sh | bash"
    echo "      then re-run: pfy setup"
  fi
  if have ollama; then
    echo "==> Ollama present (adapter; not the only spine — ADR-0014)"
    ollama list 2>/dev/null | head -5 || true
  else
    echo "note: Ollama not installed — https://ollama.com (optional for local-only)"
  fi
  if have shimmy; then
    echo "==> Shimmy present (OpenAI-compat adapter)"
  else
    echo "note: Shimmy not on PATH — https://github.com/Michael-A-Kuykendall/shimmy (optional)"
  fi
  if have llama-swap; then
    echo "==> llama-swap present (pair with llama-server; do not vendor)"
  else
    echo "note: llama-swap not on PATH — https://github.com/mostlygeek/llama-swap (optional)"
  fi
  if have docker; then
    echo "==> Docker present (agent-cage lab available)"
  else
    echo "note: Docker not found — cage lab skipped"
  fi
  if [[ ! -f "$ACTIVE_FILE" ]]; then
    echo "$(json_field default)" > "$ACTIVE_FILE"
  fi
  echo ""
  echo "setup complete. run: pfy status"
  cmd_status
}

cmd_harness_use() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: pfy harness use <id>"
  python3 -c "import json,sys; d=json.load(open('$REG')); assert any(h['id']==sys.argv[1] for h in d['harnesses'])" "$id" \
    || die "unknown harness: $id"
  echo "$id" > "$ACTIVE_FILE"
  echo "active harness → $id"
  st=$(detect_status "$id")
  echo "live status: $st"
  if [[ "$st" == "stub" || "$st" == "detected-stub" ]]; then
    echo "STUB: adapter not fully implemented. See GitHub issues labeled harness-adapter."
    python3 -c "import json; d=json.load(open('$REG')); h=next(x for x in d['harnesses'] if x['id']=='$id'); print('setup:', h.get('setup','')); print('todo:', h.get('issue_stub') or 'n/a')"
  fi
}

ensure_inference() {
  local eng="${PFY_INFERENCE:-ollama}"
  local url
  url="$(inference_url)"
  echo "==> inference backend: ${eng}  ${url}"
  case "$eng" in
    ollama)
      if have ollama; then
        if ! ollama_api_up; then
          echo "starting Ollama serve in background…"
          (ollama serve >>"$STATE_DIR/ollama.log" 2>&1 &) || true
        else
          echo "Ollama already up"
        fi
        if ! wait_http ollama_api_up 5; then
          echo "error: Ollama API did not respond on :11434 after retries (T-0101 / #54)"
          echo "continuing so cloud harnesses (e.g. grok) can still start"
        fi
      else
        echo "note: no Ollama — cloud-only harnesses may still work"
      fi
      if openai_models_up "$url"; then
        echo "OpenAI-compat /v1/models OK at $url"
      fi
      ;;
    shimmy)
      if have shimmy; then
        if ! openai_models_up "$url"; then
          echo "starting shimmy in background…"
          (shimmy serve >>"$STATE_DIR/shimmy.log" 2>&1 &) || true
        else
          echo "Shimmy already up"
        fi
        local n=0
        while [[ $n -lt 5 ]]; do
          openai_models_up "$url" && break
          sleep 1
          n=$((n + 1))
        done
        if ! openai_models_up "$url"; then
          echo "error: Shimmy OpenAI API did not respond at $url"
          echo "continuing so cloud harnesses can still start"
        fi
      else
        echo "error: PFY_INFERENCE=shimmy but shimmy not on PATH — will not fake ready"
        echo "Install: https://github.com/Michael-A-Kuykendall/shimmy  (do not vendor)"
        echo "Track: epic #53 / T-0110"
        return 2
      fi
      ;;
    llama-swap)
      if have llama-swap; then
        if ! openai_models_up "$url"; then
          echo "starting llama-swap in background…"
          (llama-swap >>"$STATE_DIR/llama-swap.log" 2>&1 &) || true
        else
          echo "llama-swap already up"
        fi
        local n=0
        while [[ $n -lt 5 ]]; do
          openai_models_up "$url" && break
          sleep 1
          n=$((n + 1))
        done
        if ! openai_models_up "$url"; then
          echo "error: llama-swap OpenAI API did not respond at $url"
          echo "continuing so cloud harnesses can still start"
        fi
      else
        echo "error: PFY_INFERENCE=llama-swap but llama-swap not on PATH — will not fake ready"
        echo "Install: https://github.com/mostlygeek/llama-swap (+ llama-server). Do not vendor."
        echo "Track: epic #53 / T-0110"
        return 2
      fi
      ;;
    *)
      echo "note: unknown PFY_INFERENCE=$eng — expected ollama|shimmy|llama-swap"
      ;;
  esac
  return 0
}

cmd_start() {
  local id="${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}"
  echo "==> start harness: $id"
  local inf_rc=0
  ensure_inference || inf_rc=$?
  if [[ "$inf_rc" -eq 2 ]]; then
    case "$id" in
      grok|opencode|hermes|claude-code|codex|gemini|exo|continue|agent-cage)
        echo "note: selected inference missing; continuing for harness $id"
        ;;
      shimmy|llama-swap|ollama)
        echo "STUB/PARTIAL: inference adapter $id not executable on PATH"
        exit 2
        ;;
      *)
        exit 2
        ;;
    esac
  fi

  case "$id" in
    grok)
      if have grok; then
        echo "launch: grok  (skills from bootstrap/grok-cli) — monitor, not local worker"
        echo "tip: from repo root, use Grok with this workspace"
        exec grok
      else
        die "grok not installed — pfy setup after installing Grok CLI"
      fi
      ;;
    ollama)
      if have ollama; then
        echo "Ollama is an inference adapter (T-0101). Pull a model: pfy models pull deepseek-coder:6.7b"
        if ollama_api_up; then
          ollama list || true
        else
          echo "error: Ollama API not responding — not ready"
          exit 2
        fi
      else
        echo "STUB/PARTIAL: ollama not on PATH"
        echo "Install: https://ollama.com  Track: #54"
        exit 2
      fi
      ;;
    shimmy)
      if have shimmy && openai_models_up "$(inference_url)"; then
        echo "Shimmy OpenAI-compat up at $(inference_url)"
      elif have shimmy; then
        echo "PARTIAL: shimmy on PATH but /v1/models not responding — not ready"
        exit 2
      else
        echo "STUB/PARTIAL: shimmy not on PATH"
        echo "Install: https://github.com/Michael-A-Kuykendall/shimmy  (do not vendor)"
        echo "Track: epic #53"
        exit 2
      fi
      ;;
    llama-swap)
      if have llama-swap && openai_models_up "$(inference_url)"; then
        echo "llama-swap OpenAI-compat up at $(inference_url)"
      elif have llama-swap; then
        echo "PARTIAL: llama-swap on PATH but /v1/models not responding — not ready"
        exit 2
      else
        echo "STUB/PARTIAL: llama-swap not on PATH"
        echo "Install: https://github.com/mostlygeek/llama-swap  (do not vendor llama.cpp)"
        echo "Track: epic #53"
        exit 2
      fi
      ;;
    opencode)
      if have opencode || have opencode-cli; then
        bin=$(have opencode && echo opencode || echo opencode-cli)
        echo "PARTIAL: launching $bin — ensure OPENCODE_SKILLS=$ROOT/bootstrap/grok-cli/skills"
        echo "worker: OPENAI_BASE_URL=$(inference_url)  (Grok remains monitor)"
        export OPENCODE_SKILLS="${OPENCODE_SKILLS:-$ROOT/bootstrap/grok-cli/skills}"
        export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$(inference_url)}"
        exec "$bin"
      else
        echo "STUB/PARTIAL: OpenCode not on PATH"
        echo "Install OpenCode, then: export OPENCODE_SKILLS=$ROOT/bootstrap/grok-cli/skills"
        echo "Track: issue OpenCode host adapter"
        exit 2
      fi
      ;;
    hermes|claude-code|codex|gemini|exo|continue|agent-cage)
      echo "STUB harness: $id"
      python3 -c "import json; d=json.load(open('$REG')); h=next(x for x in d['harnesses'] if x['id']=='$id'); print(h['summary']); print('setup:', h['setup']); print('todo:', h.get('issue_stub'))"
      echo ""
      echo "Inference adapter may still be up. Harness adapter is tracked as a GitHub issue."
      exit 2
      ;;
    *)
      die "unknown harness: $id"
      ;;
  esac
}

cmd_stage() {
  (cd "$ROOT" && make env-stage)
}

cmd_eval() {
  (cd "$ROOT" && REASON="${REASON:-pfy eval}" make eval-integration-change)
}

cmd_ship() {
  (cd "$ROOT" && make product-ship)
}

cmd_models_pull() {
  local m="${1:-}"
  [[ -n "$m" ]] || die "usage: pfy models pull <name>"
  have ollama || die "ollama not installed"
  ollama pull "$m"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help|-h|--help) usage ;;
    setup) cmd_setup "${1:-balanced}" ;;
    status) cmd_status ;;
    harness)
      local sub="${1:-list}"; shift || true
      case "$sub" in
        list) json_field list | column -t -s $'\t' 2>/dev/null || json_field list ;;
        use) cmd_harness_use "$@" ;;
        show) json_field get "${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}" ;;
        *) die "harness subcommands: list|use|show" ;;
      esac
      ;;
    start) cmd_start "$@" ;;
    stage) cmd_stage ;;
    eval) cmd_eval ;;
    ship) cmd_ship ;;
    models)
      local sub="${1:-}"; shift || true
      case "$sub" in
        pull) cmd_models_pull "$@" ;;
        *) die "models subcommands: pull" ;;
      esac
      ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
