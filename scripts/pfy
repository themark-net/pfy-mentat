cmd_decision() {
  # #230: Jev-style typed Choice/Score. Primary local = CUA-S1-FORMS. TypeSafe optional.
  local sub="${1:-smoke}"; shift || true
  case "$sub" in
    smoke|"" ) python3 "$ROOT/scripts/pfy_jev_230.py" --smoke cua-s1-forms "$@" ;;
    off|cua-s1-forms|cua|typesafe|mini-jev|path)
      if [[ "$sub" == "path" ]]; then
        python3 "$ROOT/scripts/pfy_jev_230.py" --path "$@"
      else
        python3 "$ROOT/scripts/pfy_jev_230.py" --path "$sub" "$@"
      fi
      ;;
    compact) python3 "$ROOT/scripts/pfy_jev_230.py" --compact "$@" ;;
    route) python3 "$ROOT/scripts/pfy_jev_230.py" --route "$@" ;;
    attach) python3 "$ROOT/scripts/pfy_jev_230.py" --attach "$@" ;;
    queue) python3 "$ROOT/scripts/pfy_jev_230.py" --queue "$@" ;;
    selftest) python3 "$ROOT/scripts/pfy_jev_230.py" --selftest "$@" ;;
    *) echo "decision subcommands: smoke|off|cua-s1-forms|typesafe|mini-jev|compact|route|queue" >&2; return 2 ;;
  esac
}

