cmd_smoke() {
  # #197: FreeToken-first models list + one chat/completions smoke (reuse Attach #193 prove)
  local rt engine st base
  rt=$(local_runtime)
  engine=$(rt_get "$rt" engine)
  st=$(rt_get "$rt" status)
  base=$(rt_get "$rt" base_url)
  # FreeToken-first probe (same spine as doctor/endpoint/models)
  if curl -sf --max-time 1 http://127.0.0.1:1919/v1/models >/dev/null 2>&1 \
    || curl -sf --max-time 1 http://127.0.0.1:1919/health >/dev/null 2>&1; then
    engine=freetoken
    base="http://127.0.0.1:1919"
    st=ready
  fi
  if [[ "$st" != "ready" || -z "$base" || "$base" == "(none)" ]]; then
    echo "FAIL: no local engine"
    echo "  next: ./pfy up"
    return 1
  fi
  # Prefer live base; prove helper openai_compat_root strips trailing /v1
  base="${base%/}"
  local out rc
  set +e
  out="$(python3 - "$ROOT" "$base" "$engine" <<'PY'
import importlib.util
import json
import sys
import urllib.request
from pathlib import Path

root, base, engine = sys.argv[1], sys.argv[2], sys.argv[3]
path = Path(root) / "scripts" / "pfy_attach_usable_193.py"
if not path.is_file():
    print("FAIL: prove helper missing · ./pfy up")
    raise SystemExit(2)
spec = importlib.util.spec_from_file_location("pfy_attach_usable_193", path)
mod = importlib.util.module_from_spec(spec)
spec.loader.exec_module(mod)

def inspect_models(root_url):
    root_url = mod.openai_compat_root(root_url)
    ids, seen = [], set()
    for path_suffix in ("/v1/models", "/api/tags"):
        try:
            req = urllib.request.Request(root_url + path_suffix, method="GET")
            with urllib.request.urlopen(req, timeout=2) as r:
                d = json.loads(r.read().decode() or "{}")
        except Exception:
            continue
        if not isinstance(d, dict):
            continue
        for m in d.get("data") or []:
            if isinstance(m, dict):
                x = (m.get("id") or m.get("name") or "").strip()
            else:
                x = str(m).strip()
            if x and x not in seen:
                seen.add(x)
                ids.append(x)
        for m in d.get("models") or []:
            if isinstance(m, dict):
                x = (m.get("name") or m.get("model") or m.get("id") or "").strip()
            else:
                x = str(m).strip()
            if x and x not in seen:
                seen.add(x)
                ids.append(x)
    return ids

ok, model, err = mod.prove_developer_usable(base, inspect_models)
if ok:
    print("PASS smoke · %s · %s" % (model, engine))
    raise SystemExit(0)
reason = (err or "smoke failed").strip() or "smoke failed"
print("FAIL: %s" % reason)
print("  next: ./pfy up")
raise SystemExit(1)
PY
)"
  rc=$?
  set -e
  printf '%s\n' "$out"
  return "$rc"
}

record_verb() {
  mkdir -p "$STATE_DIR"
  {
    printf 'verb: %s\n' "$*"
    printf 'when: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$STATE_DIR/last-verb"
}

cmd_board() {
  [[ -f "$ROOT/scripts/pfy-board.py" ]] || die "scripts/pfy-board.py missing"
  local open_flag=0
  local -a args=()
  local a
  for a in "$@"; do
    if [[ "$a" == "--open" ]]; then
      open_flag=1
    else
      args+=("$a")
    fi
  done
  if [[ "$open_flag" -eq 1 ]]; then
    echo "note: --open is a hatch; native window is the main path"
    open_board_url || true
    if [[ ${#args[@]} -gt 0 ]]; then
      exec python3 "$ROOT/scripts/pfy-board.py" "${args[@]}"
    else
      exec python3 "$ROOT/scripts/pfy-board.py"
    fi
  fi
  launch_native_gui
}

main() {
  local cmd="${1:-gui}"
  shift || true
  if [[ "$cmd" != "help" && "$cmd" != "-h" && "$cmd" != "--help" ]]; then
    record_verb "$cmd" "$@"
  fi
  case "$cmd" in
    help|-h|--help) usage ;;
    gui|"") cmd_gui ;;
    setup) cmd_setup "${1:-balanced}" ;;
    status) cmd_status ;;
    usage) cmd_usage ;;
    endpoint) cmd_endpoint ;;
    doctor) cmd_doctor ;;
    smoke) cmd_smoke ;;
    context) cmd_context "$@" ;;
    code-graph|axon) cmd_code_graph "$@" ;;
    board) cmd_board "$@" ;;
    up) cmd_up ;;
    harness)
      local sub="${1:-list}"; shift || true
      case "$sub" in
        list) json_field list | column -t -s $'\t' 2>/dev/null || json_field list ;;
        use) cmd_harness_use "$@" ;;
        show) json_field get "${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}" ;;
        *) die "harness subcommands: list|use|show" ;;
      esac
      ;;
    start) cmd_start "$@" ;;
    stage) cmd_stage "$@" ;;
    env|launch-env) cmd_env ;;
    eval) cmd_eval ;;
    ship) cmd_ship ;;
    models)
      local sub="${1:-list}"; shift || true
      case "$sub" in
        list|"") cmd_models_list ;;
        pull) cmd_models_pull "$@" ;;
        recommend) cmd_models_recommend "$@" ;;
        try) cmd_models_try "$@" ;;
        gab-sync|gab_sync) cmd_models_gab_sync "$@" ;;
        gab-pull|gab_pull) cmd_models_gab_pull "$@" ;;
        *) die "models subcommands: list|pull|recommend|try|gab-sync|gab-pull" ;;
      esac
      ;;
    catalog) cmd_catalog "$@" ;;
    launch) cmd_launch "$@" ;;
    decision|jev) cmd_decision "$@" ;;
    toolset|toolsets) exec python3 "$ROOT/pfylib/cli.py" toolset "$@" ;;
    hedge) exec python3 "$ROOT/pfylib/cli.py" hedge "$@" ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
