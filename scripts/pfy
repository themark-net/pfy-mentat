#!/usr/bin/env bash
# pfy — simple operator surface for pfy-mentat
# Inference first (FreeToken / llama-swap / llama-server / Ollama), harnesses attach.
set -euo pipefail
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [[ -L "$SCRIPT_PATH" ]]; do
  link="$(readlink "$SCRIPT_PATH")"
  if [[ "$link" != /* ]]; then
    SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/$link"
  else
    SCRIPT_PATH="$link"
  fi
done
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
REG="$ROOT/data/harnesses.json"
DETECT="$ROOT/scripts/detect-local-runtime.sh"
STATE_DIR="${PFY_STATE_DIR:-$HOME/.pfy-mentat}"
ACTIVE_FILE="$STATE_DIR/active-harness"
mkdir -p "$STATE_DIR"

die() { echo "error: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'U'
pfy — simple setup & launch for the pfy-mentat stack

  pfy setup [local-only|balanced|max-performance]
  pfy status
  pfy harness list|use <id>|show [id]
  pfy start [harness]
  pfy stage | eval | ship
  pfy models pull <name>   (Ollama adapter only)
  pfy help

Inference detect: FreeToken (:1919) → llama-swap (:9292) → llama-server (:8080) → Ollama.
Override: PFY_LOCAL_RUNTIME, LOCAL_OPENAI_BASE_URL.
Detector is invoked with bash (no git +x required).
U
}

json_field() {
  python3 - "$REG" "$1" "${2:-}" <<'PY'
import json,sys
reg=json.load(open(sys.argv[1]))
cmd=sys.argv[2]
arg=sys.argv[3] if len(sys.argv)>3 else ""
if cmd=="list":
    for h in reg["harnesses"]:
        print(f"{h['id']}\t{h['status']}\t{h['role']}\t{h['name']}")
elif cmd=="default":
    print(reg.get("default_harness","grok"))
elif cmd=="get":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print(json.dumps(h, indent=2)); break
    else:
        sys.exit(1)
elif cmd=="detects":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print("\n".join(h.get("detect") or [])); break
PY
}

local_runtime() {
  if [[ -f "$DETECT" ]]; then
    bash "$DETECT" --json
  else
    echo '{"engine":"none","status":"missing","base_url":""}'
  fi
}

detect_status() {
  local id="$1"
  local status_reg found=0 bins
  status_reg=$(python3 -c "import json; d=json.load(open('$REG')); print(next(h['status'] for h in d['harnesses'] if h['id']=='$id'))")
  bins=$(json_field detects "$id" || true)
  if [[ -n "$bins" ]]; then
    while IFS= read -r b; do
      [[ -z "$b" ]] && continue
      if [[ "$b" == "exo.sh" ]]; then
        [[ -x "$ROOT/exo.sh" || -x "$HOME/exo/exo.sh" ]] && found=1
      elif have "$b"; then
        found=1
      fi
    done <<< "$bins"
  fi
  case "$id" in
    freetoken|ollama|shimmy|llama-swap|llama-server|llama.cpp)
      python3 - "$(local_runtime)" "$id" "$found" <<'PY'
import json,sys
rt=json.loads(sys.argv[1]); id=sys.argv[2]; found=int(sys.argv[3])
eng=rt.get("engine","")
alias={"llama.cpp":"llama-server","llama-server":"llama.cpp","ft":"freetoken","freetoken":"ft"}
if eng==id or alias.get(eng)==id or alias.get(id)==eng:
    print(rt.get("status","missing")); sys.exit(0)
# Binary present but not the live engine: partial. No binary: missing — never registry-partial.
print("partial" if found else "missing")
PY
      return
      ;;
  esac
  if [[ "$status_reg" == "stub" ]]; then
    if [[ "$found" -eq 1 ]]; then echo "detected-stub"; else echo "stub"; fi
    return
  fi
  if [[ "$found" -eq 1 ]]; then echo "ready"
  else echo "missing"
  fi
}

cmd_status() {
  echo "pfy-mentat simple surface"
  echo "root: $ROOT"
  echo "active harness: $(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)"
  rt=$(local_runtime)
  python3 -c "import json,sys; d=json.loads(sys.argv[1]); print('local runtime: engine=%s status=%s base_url=%s'%(d.get('engine'),d.get('status'),d.get('base_url') or '(none)'))" "$rt"
  echo ""
  printf "%-14s %-14s %-8s %s\n" "ID" "STATUS" "ROLE" "NAME"
  printf "%-14s %-14s %-8s %s\n" "----" "------" "----" "----"
  json_field list | while IFS=$'\t' read -r id st role name; do
    live=$(detect_status "$id")
    printf "%-14s %-14s %-8s %s\n" "$id" "$live" "$role" "$name"
  done
  echo ""
  echo "next: pfy setup   |   pfy start   |   pfy harness list"
  echo "override: PFY_LOCAL_RUNTIME=freetoken|llama-swap|llama-server|ollama"
}

cmd_setup() {
  local profile="${1:-balanced}"
  echo "==> pfy setup (profile=$profile)"
  (cd "$ROOT" && make env-init)
  if [[ -f "$ROOT/.env" ]]; then
    if grep -q '^DEPLOY_PROFILE=' "$ROOT/.env" 2>/dev/null; then
      sed -i.bak "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null \
        || sed -i '' "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null || true
    else
      echo "DEPLOY_PROFILE=$profile" >> "$ROOT/.env"
    fi
  fi
  if have grok || [[ -x "$HOME/.local/bin/grok" ]]; then
    echo "==> Grok CLI found — installing skills"
    bash "$ROOT/bootstrap/grok-cli/install.sh" || echo "warn: grok install had issues"
  else
    echo "note: Grok CLI not on PATH — install then re-run: pfy setup"
  fi
  for bin in ft freetoken llama-swap llama-server ollama shimmy; do
    if have "$bin"; then echo "==> $bin present"; fi
  done
  have ft || have freetoken || echo "note: FreeToken not installed (uv pip install \"freetoken[accel]\")"
  have docker && echo "==> Docker present" || echo "note: Docker not found — cage lab skipped"
  if [[ ! -f "$ACTIVE_FILE" ]]; then
    echo "$(json_field default)" > "$ACTIVE_FILE"
  fi
  echo ""
  cmd_status
}

cmd_harness_use() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: pfy harness use <id>"
  python3 -c "import json,sys; d=json.load(open('$REG')); assert any(h['id']==sys.argv[1] for h in d['harnesses'])" "$id" \
    || die "unknown harness: $id"
  echo "$id" > "$ACTIVE_FILE"
  echo "active harness → $id"
  echo "live status: $(detect_status "$id")"
}

cmd_start() {
  local id="${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}"
  echo "==> start harness: $id"
  rt=$(local_runtime)
  python3 -c "import json,sys; print('local runtime:', json.loads(sys.argv[1]))" "$rt"
  engine=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('engine',''))" "$rt")
  st=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('status',''))" "$rt")
  base=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('base_url',''))" "$rt")
  export LOCAL_OPENAI_BASE_URL="${LOCAL_OPENAI_BASE_URL:-$base}"

  if [[ "$st" != "ready" ]]; then
    if [[ "$engine" == "ollama" ]] && have ollama; then
      if ! curl -sf --max-time 1 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        echo "starting Ollama serve in background…"
        (ollama serve >>"$STATE_DIR/ollama.log" 2>&1 &) || true
        sleep 1
        export LOCAL_OPENAI_BASE_URL="${LOCAL_OPENAI_BASE_URL:-http://127.0.0.1:11434/v1}"
      fi
    elif [[ "$engine" == "freetoken" ]]; then
      echo "STUB: FreeToken not serving. ft serve --model <id>  (see #76)"
    elif [[ "$engine" == "llama-swap" || "$engine" == "llama-server" || "$engine" == "llama.cpp" ]]; then
      echo "STUB: $engine HTTP not up. See #76."
    else
      echo "note: no local runtime ready — install FreeToken, llama-swap, llama-server, or ollama (#76)"
    fi
  else
    echo "inference up: $engine at ${LOCAL_OPENAI_BASE_URL:-$base}"
  fi

  case "$id" in
    grok)
      have grok || die "grok not installed"
      exec grok
      ;;
    freetoken|ollama|shimmy|llama-swap|llama-server|llama.cpp)
      echo "inference spine: $id  LOCAL_OPENAI_BASE_URL=${LOCAL_OPENAI_BASE_URL:-}"
      if [[ "$st" != "ready" ]]; then echo "honest stub: $id not healthy (#76)"; exit 2; fi
      ;;
    opencode)
      if have opencode || have opencode-cli; then
        bin=$(have opencode && echo opencode || echo opencode-cli)
        export OPENCODE_SKILLS="${OPENCODE_SKILLS:-$ROOT/bootstrap/grok-cli/skills}"
        exec "$bin"
      else
        echo "STUB: OpenCode not on PATH (#55)"; exit 2
      fi
      ;;
    hermes|claude-code|codex|gemini|exo|continue|agent-cage)
      echo "STUB harness: $id"
      exit 2
      ;;
    *) die "unknown harness: $id" ;;
  esac
}

cmd_stage() { (cd "$ROOT" && make env-stage); }
cmd_eval() { (cd "$ROOT" && REASON="${REASON:-pfy eval}" make eval-integration-change); }
cmd_ship() { (cd "$ROOT" && make product-ship); }
cmd_models_pull() {
  local m="${1:-}"
  [[ -n "$m" ]] || die "usage: pfy models pull <name>"
  have ollama || die "ollama not installed"
  ollama pull "$m"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help|-h|--help) usage ;;
    setup) cmd_setup "${1:-balanced}" ;;
    status) cmd_status ;;
    harness)
      local sub="${1:-list}"; shift || true
      case "$sub" in
        list) json_field list | column -t -s $'\t' 2>/dev/null || json_field list ;;
        use) cmd_harness_use "$@" ;;
        show) json_field get "${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}" ;;
        *) die "harness subcommands: list|use|show" ;;
      esac
      ;;
    start) cmd_start "$@" ;;
    stage) cmd_stage ;;
    eval) cmd_eval ;;
    ship) cmd_ship ;;
    models)
      local sub="${1:-}"; shift || true
      case "$sub" in pull) cmd_models_pull "$@" ;; *) die "models subcommands: pull" ;; esac
      ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
