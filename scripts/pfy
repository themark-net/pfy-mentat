#!/usr/bin/env bash
# pfy — simple operator surface for pfy-mentat
# Feel: inference first (llama-swap / llama-server / Shimmy / Ollama), harnesses attach.
set -euo pipefail
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [[ -L "$SCRIPT_PATH" ]]; do
  link="$(readlink "$SCRIPT_PATH")"
  if [[ "$link" != /* ]]; then
    SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/$link"
  else
    SCRIPT_PATH="$link"
  fi
done
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
REG="$ROOT/data/harnesses.json"
DETECT="$ROOT/scripts/detect-local-runtime.sh"
STATE_DIR="${PFY_STATE_DIR:-$HOME/.pfy-mentat}"
ACTIVE_FILE="$STATE_DIR/active-harness"
mkdir -p "$STATE_DIR"

die() { echo "error: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

usage() {
  cat <<'U'
pfy — simple setup & launch for the pfy-mentat stack

  pfy setup [local-only|balanced|max-performance]
      One-shot: env + skills + detect local runtime

  pfy status
      What is installed / ready / stub (includes inference probe)

  pfy harness list
  pfy harness use <id>
  pfy harness show [id]

  pfy start [harness]
      Ensure local OpenAI-compat inference when possible, then launch harness

  pfy stage
      Green path: env-check + structural eval (+ soft local runtime)

  pfy eval
      Integration self-mod gates (catalog hygiene)

  pfy ship
      Product verify (+ optional push)

  pfy models pull <name>
      ollama pull wrapper (Ollama adapter only)

  pfy help

Philosophy: inference comes up once (llama-swap → llama-server → Shimmy → Ollama);
harnesses (Grok, OpenCode, …) attach. Override: PFY_LOCAL_RUNTIME, LOCAL_OPENAI_BASE_URL.
Unfinished harnesses are stubs with a GitHub issue — not hidden Make targets.
U
}

json_field() {
  python3 - "$REG" "$1" "${2:-}" <<'PY'
import json,sys
reg=json.load(open(sys.argv[1]))
cmd=sys.argv[2]
arg=sys.argv[3] if len(sys.argv)>3 else ""
if cmd=="list":
    for h in reg["harnesses"]:
        print(f"{h['id']}\t{h['status']}\t{h['role']}\t{h['name']}")
elif cmd=="default":
    print(reg.get("default_harness","grok"))
elif cmd=="get":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print(json.dumps(h, indent=2)); break
    else:
        sys.exit(1)
elif cmd=="detects":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print("\n".join(h.get("detect") or [])); break
elif cmd=="all":
    print(json.dumps(reg["harnesses"]))
PY
}

local_runtime() {
  if [[ -x "$DETECT" ]]; then
    bash "$DETECT" --json
  else
    echo '{"engine":"none","status":"missing","base_url":""}'
  fi
}

detect_status() {
  local id="$1"
  local status_reg
  status_reg=$(python3 -c "import json; d=json.load(open('$REG')); print(next(h['status'] for h in d['harnesses'] if h['id']=='$id'))")
  local bins
  bins=$(json_field detects "$id" || true)
  local found=0
  if [[ -n "$bins" ]]; then
    while IFS= read -r b; do
      [[ -z "$b" ]] && continue
      if [[ "$b" == "exo.sh" ]]; then
        [[ -x "$ROOT/exo.sh" || -x "$HOME/exo/exo.sh" ]] && found=1
      elif have "$b"; then
        found=1
      fi
    done <<< "$bins"
  fi
  case "$id" in
    ollama|shimmy|llama-swap|llama-server)
      python3 -c "import json,sys; d=json.loads(sys.argv[1]); print(d.get('status','missing') if d.get('engine')==sys.argv[2] else ('ready' if False else 'missing'))" "$(local_runtime)" "$id" 2>/dev/null || true
      local rt
      rt=$(local_runtime)
      python3 - "$rt" "$id" "$found" "$status_reg" <<'PY'
import json,sys
rt=json.loads(sys.argv[1]); id=sys.argv[2]; found=int(sys.argv[3]); reg=sys.argv[4]
if rt.get("engine")==id:
    print(rt.get("status","missing")); sys.exit(0)
print("ready" if found else ("partial" if reg=="partial" else ("stub" if reg=="stub" else "missing")))
PY
      return
      ;;
  esac
  if [[ "$status_reg" == "stub" ]]; then
    if [[ "$found" -eq 1 ]]; then echo "detected-stub"; else echo "stub"; fi
    return
  fi
  if [[ "$found" -eq 1 ]]; then echo "ready"
  elif [[ "$status_reg" == "partial" ]]; then echo "partial"
  else echo "missing"
  fi
}

cmd_status() {
  echo "pfy-mentat simple surface"
  echo "root: $ROOT"
  echo "active harness: $(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)"
  rt=$(local_runtime)
  python3 -c "import json,sys; d=json.loads(sys.argv[1]); print('local runtime: engine=%s status=%s base_url=%s'%(d.get('engine'),d.get('status'),d.get('base_url') or '(none)'))" "$rt"
  echo ""
  printf "%-14s %-14s %-8s %s\n" "ID" "STATUS" "ROLE" "NAME"
  printf "%-14s %-14s %-8s %s\n" "----" "------" "----" "----"
  json_field list | while IFS=$'\t' read -r id st role name; do
    live=$(detect_status "$id")
    printf "%-14s %-14s %-8s %s\n" "$id" "$live" "$role" "$name"
  done
  echo ""
  echo "next: pfy setup   |   pfy start   |   pfy harness list"
  echo "override: PFY_LOCAL_RUNTIME=llama-swap|llama-server|shimmy|ollama"
}

cmd_setup() {
  local profile="${1:-balanced}"
  echo "==> pfy setup (profile=$profile)"
  (cd "$ROOT" && make env-init)
  if [[ -f "$ROOT/.env" ]]; then
    if grep -q '^DEPLOY_PROFILE=' "$ROOT/.env" 2>/dev/null; then
      sed -i.bak "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null \
        || sed -i '' "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null || true
    else
      echo "DEPLOY_PROFILE=$profile" >> "$ROOT/.env"
    fi
  fi
  if have grok || [[ -x "$HOME/.local/bin/grok" ]]; then
    echo "==> Grok CLI found — installing skills"
    bash "$ROOT/bootstrap/grok-cli/install.sh" || echo "warn: grok install had issues"
  else
    echo "note: Grok CLI not on PATH — install: curl -fsSL https://x.ai/cli/install.sh | bash"
    echo "      then re-run: pfy setup"
  fi
  for bin in llama-swap llama-server shimmy ollama; do
    if have "$bin"; then echo "==> $bin present"; else echo "note: $bin not installed (optional local runtime)"; fi
  done
  if have docker; then
    echo "==> Docker present (agent-cage lab available)"
  else
    echo "note: Docker not found — cage lab skipped"
  fi
  if [[ ! -f "$ACTIVE_FILE" ]]; then
    echo "$(json_field default)" > "$ACTIVE_FILE"
  fi
  echo ""
  echo "setup complete. run: pfy status"
  cmd_status
}

cmd_harness_use() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: pfy harness use <id>"
  python3 -c "import json,sys; d=json.load(open('$REG')); assert any(h['id']==sys.argv[1] for h in d['harnesses'])" "$id" \
    || die "unknown harness: $id"
  echo "$id" > "$ACTIVE_FILE"
  echo "active harness → $id"
  st=$(detect_status "$id")
  echo "live status: $st"
  if [[ "$st" == "stub" || "$st" == "detected-stub" ]]; then
    echo "STUB: adapter not fully implemented. See GitHub issues labeled harness-adapter."
    python3 -c "import json; d=json.load(open('$REG')); h=next(x for x in d['harnesses'] if x['id']=='$id'); print('setup:', h.get('setup','')); print('todo:', h.get('issue_stub') or 'n/a')"
  fi
}

cmd_start() {
  local id="${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}"
  echo "==> start harness: $id"
  rt=$(local_runtime)
  python3 -c "import json,sys; d=json.loads(sys.argv[1]); print('local runtime:', d)" "$rt"
  engine=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('engine',''))" "$rt")
  st=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('status',''))" "$rt")
  base=$(python3 -c "import json,sys; print(json.loads(sys.argv[1]).get('base_url',''))" "$rt")
  export LOCAL_OPENAI_BASE_URL="${LOCAL_OPENAI_BASE_URL:-$base}"

  if [[ "$st" != "ready" ]]; then
    if [[ "$engine" == "ollama" ]] && have ollama; then
      if ! curl -sf --max-time 1 http://127.0.0.1:11434/api/tags >/dev/null 2>&1; then
        echo "starting Ollama serve in background…"
        (ollama serve >>"$STATE_DIR/ollama.log" 2>&1 &) || true
        sleep 1
        export LOCAL_OPENAI_BASE_URL="${LOCAL_OPENAI_BASE_URL:-http://127.0.0.1:11434/v1}"
      fi
    elif [[ "$engine" == "shimmy" ]] && have shimmy; then
      echo "STUB: Shimmy on PATH but not serving. Start it, then re-run pfy start. See #76."
    elif [[ "$engine" == "llama-swap" || "$engine" == "llama-server" ]]; then
      echo "STUB: $engine on PATH but not serving. Start llama-swap/llama-server, then re-run. See #76."
    else
      echo "note: no local runtime ready — cloud-only harnesses may still work"
      echo "      install one of: llama-swap, llama-server, shimmy, ollama  (#76)"
    fi
  else
    echo "inference up: $engine at ${LOCAL_OPENAI_BASE_URL:-$base}"
  fi

  case "$id" in
    grok)
      if have grok; then
        echo "launch: grok  (skills from bootstrap/grok-cli)"
        exec grok
      else
        die "grok not installed — pfy setup after installing Grok CLI"
      fi
      ;;
    ollama|shimmy|llama-swap|llama-server)
      echo "inference spine: $id  LOCAL_OPENAI_BASE_URL=${LOCAL_OPENAI_BASE_URL:-}"
      if [[ "$id" == "ollama" ]] && have ollama; then ollama list || true; fi
      ;;
    opencode)
      if have opencode || have opencode-cli; then
        bin=$(have opencode && echo opencode || echo opencode-cli)
        echo "PARTIAL: launching $bin — OPENCODE_SKILLS=$ROOT/bootstrap/grok-cli/skills"
        echo "         LOCAL_OPENAI_BASE_URL=${LOCAL_OPENAI_BASE_URL:-}"
        export OPENCODE_SKILLS="${OPENCODE_SKILLS:-$ROOT/bootstrap/grok-cli/skills}"
        exec "$bin"
      else
        echo "STUB/PARTIAL: OpenCode not on PATH"
        echo "Track: issue #55"
        exit 2
      fi
      ;;
    hermes|claude-code|codex|gemini|exo|continue|agent-cage)
      echo "STUB harness: $id"
      python3 -c "import json; d=json.load(open('$REG')); h=next(x for x in d['harnesses'] if x['id']=='$id'); print(h['summary']); print('setup:', h['setup']); print('todo:', h.get('issue_stub'))"
      exit 2
      ;;
    *)
      die "unknown harness: $id"
      ;;
  esac
}

cmd_stage() {
  (cd "$ROOT" && make env-stage)
}

cmd_eval() {
  (cd "$ROOT" && REASON="${REASON:-pfy eval}" make eval-integration-change)
}

cmd_ship() {
  (cd "$ROOT" && make product-ship)
}

cmd_models_pull() {
  local m="${1:-}"
  [[ -n "$m" ]] || die "usage: pfy models pull <name>"
  have ollama || die "ollama not installed (this wrapper is the Ollama adapter)"
  ollama pull "$m"
}

main() {
  local cmd="${1:-help}"
  shift || true
  case "$cmd" in
    help|-h|--help) usage ;;
    setup) cmd_setup "${1:-balanced}" ;;
    status) cmd_status ;;
    harness)
      local sub="${1:-list}"; shift || true
      case "$sub" in
        list) json_field list | column -t -s $'\t' 2>/dev/null || json_field list ;;
        use) cmd_harness_use "$@" ;;
        show) json_field get "${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}" ;;
        *) die "harness subcommands: list|use|show" ;;
      esac
      ;;
    start) cmd_start "$@" ;;
    stage) cmd_stage ;;
    eval) cmd_eval ;;
    ship) cmd_ship ;;
    models)
      local sub="${1:-}"; shift || true
      case "$sub" in
        pull) cmd_models_pull "$@" ;;
        *) die "models subcommands: pull" ;;
      esac
      ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
