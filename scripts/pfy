  print_live_models "${LOCAL_OPENAI_BASE_URL:-$base}"
}


cmd_endpoint() {
  # #177: one-line FreeToken-first live OpenAI-compat base (copy-friendly)
  local rt engine st base
  rt=$(local_runtime)
  engine=$(rt_get "$rt" engine)
  st=$(rt_get "$rt" status)
  base=$(rt_get "$rt" base_url)
  if curl -sf --max-time 1 http://127.0.0.1:1919/v1/models >/dev/null 2>&1 \
    || curl -sf --max-time 1 http://127.0.0.1:1919/health >/dev/null 2>&1; then
    engine=freetoken
    base="http://127.0.0.1:1919"
    st=ready
  fi
  if [[ "$st" != "ready" || -z "$base" || "$base" == "(none)" ]]; then
    echo "FAIL: no local engine" >&2
    echo "  next: ./pfy up" >&2
    return 1
  fi
  # OpenAI-compat /v1 base (match live_openai_base)
  base="${base%/}"
  if [[ "$base" != */v1 ]]; then
    base="${base}/v1"
  fi
  printf '%s\n' "$base"
}

cmd_doctor() {
  # #185: one-shot FreeToken-first health — exit 0 only when live ready
  local rt engine st base tok
  echo "pfy doctor"
  rt=$(local_runtime)
  engine=$(rt_get "$rt" engine)
  st=$(rt_get "$rt" status)
  base=$(rt_get "$rt" base_url)
  # FreeToken-first probe (same spine as endpoint/models/usage)
  if curl -sf --max-time 1 http://127.0.0.1:1919/v1/models >/dev/null 2>&1 \
    || curl -sf --max-time 1 http://127.0.0.1:1919/health >/dev/null 2>&1; then
    engine=freetoken
    base="http://127.0.0.1:1919"
    st=ready
  fi
  echo "detect: engine=${engine:-(none)} status=${st:-(none)}"
  if [[ "$st" != "ready" || -z "$base" || "$base" == "(none)" ]]; then
    echo "endpoint: (none)"
    echo "FAIL: no local engine"
    echo "  next: ./pfy up"
    return 1
  fi
  base="${base%/}"
  local ep="$base"
  if [[ "$ep" != */v1 ]]; then ep="${ep}/v1"; fi
  echo "endpoint: $ep"
  # optional models (best-effort; do not fail doctor solely on empty list if engine ready)
  print_live_models "$base" "" || true
  tok="$(resolve_tok_path "$engine" "$base" || true)"
  if [[ -n "$tok" ]]; then echo "tok_path: $tok"; else echo "tok_path: SKIP"; fi
  print_vram_line "$engine" "$base"
  echo "PASS doctor · $engine ready"
  return 0
}

