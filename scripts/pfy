#!/usr/bin/env bash
# pfy — simple operator surface for pfy-mentat
# Inference first (FreeToken / llama-swap / llama-server / Ollama), then native operator window.
# Named ./pfy start <harness> still execs that harness. Bare ./pfy does not exec a harness.
set -euo pipefail
SCRIPT_PATH="${BASH_SOURCE[0]:-$0}"
while [[ -L "$SCRIPT_PATH" ]]; do
  link="$(readlink "$SCRIPT_PATH")"
  if [[ "$link" != /* ]]; then
    SCRIPT_PATH="$(cd "$(dirname "$SCRIPT_PATH")" && pwd)/$link"
  else
    SCRIPT_PATH="$link"
  fi
done
ROOT="$(cd "$(dirname "$SCRIPT_PATH")/.." && pwd)"
REG="$ROOT/data/harnesses.json"
DETECT="$ROOT/scripts/detect-local-runtime.sh"
STATE_DIR="${PFY_STATE_DIR:-$HOME/.pfy-mentat}"
ACTIVE_FILE="$STATE_DIR/active-harness"
mkdir -p "$STATE_DIR"

die() { echo "error: $*" >&2; exit 1; }
have() { command -v "$1" >/dev/null 2>&1; }

board_url() {
  echo "http://127.0.0.1:${PFY_BOARD_PORT:-8765}"
}

print_board_url() {
  echo "board: $(board_url)"
}

open_board_url() {
  local url
  url="$(board_url)"
  if have xdg-open; then
    xdg-open "$url" >/dev/null 2>&1 && return 0
  elif have open; then
    open "$url" >/dev/null 2>&1 && return 0
  fi
  echo "note: could not open browser - $url"
  return 0
}

tauri_bin() {
  # Fresh only: not older than frontend HTML, and contains run_stage.
  # Stale leftover binaries must not win. Never print a rebuild one-liner.
  local html="$ROOT/gui/operator/frontend/index.html"
  local cands=(
    "$ROOT/gui/operator/src-tauri/target/release/pfy-operator"
    "$ROOT/gui/operator/src-tauri/target/debug/pfy-operator"
  )
  local b
  for b in "${cands[@]}"; do
    [[ -x "$b" ]] || continue
    if [[ -f "$html" && "$b" -ot "$html" ]]; then
      continue
    fi
    if ! grep -a -F -q "run_stage" "$b" 2>/dev/null; then
      continue
    fi

    if ! grep -a -F -q "launch_env" "$b" 2>/dev/null; then
      continue
    fi
    echo "$b"
    return 0
  done
  return 1
}

warn_if_active_stub() {
  local preferred
  preferred="$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)"
  [[ -n "$preferred" ]] || preferred="grok"
  case "$preferred" in
    continue|agent-cage)
      echo "FAIL: active harness is $preferred — no grok/opencode fallback"
      echo "  pfy harness use grok"
      ;;
  esac
}

launch_native_gui() {
  local tbin
  tbin="$(tauri_bin || true)"
  if [[ -n "$tbin" ]]; then
    echo "native window (Tauri)"
    export PFY_ROOT="$ROOT"
    exec "$tbin"
  fi
  if [[ -f "$ROOT/scripts/pfy-gui.py" ]]; then
    # print native window (webkit|tk); never pywebview as product path
    exec python3 "$ROOT/scripts/pfy-gui.py"
  fi
  mkdir -p "$STATE_DIR"
  art="$STATE_DIR/gui-stopped-exit.txt"
  printf 'STOPPED_EXIT\nerror: scripts/pfy-gui.py missing\n' >"$art"
  echo "STOPPED_EXIT: scripts/pfy-gui.py missing" >&2
  echo "artifact: $art" >&2
  exit 1
}

cmd_gui() {
  ensure_inference
  run_product_stage
  warn_if_active_stub
  echo "native window is the main interface (no harness exec into this process)"
  echo "  Attach grok / Attach opencode from the window (sidecar). named: ./pfy start <harness>"
  launch_native_gui
}

usage() {
  cat <<'U'
pfy — simple setup & launch for the pfy-mentat stack

  pfy                     inference → env-stage → native operator window (no harness exec)
  pfy env                 inference + env-stage (no window, no harness exec)
  pfy setup [local-only|balanced|max-performance]
  pfy status
  pfy up                  same as bare pfy (native window; attach is in-window sidecar)
  pfy harness list|use <id>|show [id]
  pfy start [harness]     no name: same as bare pfy. named: exec that harness after inference/stage
  pfy stage [--lab]       env-stage; --lab optional personal cage lab (doctor→setup→up-mcp)
  pfy eval | ship
  pfy models              list models from the live local endpoint (inspect-only)
  pfy models pull <name>  live engine (FreeToken records name; Ollama pulls; llama skip)
  pfy board [--open]      alias of the native operator window
                          --open is an optional hatch (not the main path)
  pfy help

Native window is the main interface. Tauri when the binary is current; else already-on-box webkit or stdlib tk (scripts/pfy-gui.py). pywebview is PFY_GUI_DEV=1 only. Window always opens.
Browser --open is not required. Board is not a supervisor.
Continue/agent-cage active: FAIL, copy `pfy harness use grok` (no fallback).

Inference detect: FreeToken (:1919) → llama-swap (:9292) → llama-server (:8080) → Ollama.
Override: PFY_LOCAL_RUNTIME, LOCAL_OPENAI_BASE_URL.
FreeToken model: PFY_FT_MODEL (then LOCAL_CODER_MODEL, FREETOKEN_MODEL).
Ollama adapter model: PFY_OLLAMA_MODEL (then LOCAL_CODER_MODEL).
llama-server model path: PFY_LLAMA_MODEL (then LOCAL_CODER_MODEL as a GGUF path).
Detector is invoked with bash (no git +x required).
Docker not required for basic start.
U
}

json_field() {
  python3 - "$REG" "$1" "${2:-}" <<'PY'
import json,sys
reg=json.load(open(sys.argv[1]))
cmd=sys.argv[2]
arg=sys.argv[3] if len(sys.argv)>3 else ""
if cmd=="list":
    for h in reg["harnesses"]:
        print(f"{h['id']}\t{h['status']}\t{h['role']}\t{h['name']}")
elif cmd=="default":
    print(reg.get("default_harness","grok"))
elif cmd=="get":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print(json.dumps(h, indent=2)); break
    else:
        sys.exit(1)
elif cmd=="detects":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            print("\n".join(h.get("detect") or [])); break
elif cmd=="github_issue":
    for h in reg["harnesses"]:
        if h["id"]==arg:
            gi=h.get("github_issue")
            print("" if gi in (None,"") else gi)
            break
    else:
        sys.exit(1)
elif cmd=="adapter_ids":
    for h in reg["harnesses"]:
        if h.get("role")=="harness":
            print(h["id"])
PY
}

local_runtime() {
  if [[ -f "$DETECT" ]]; then
    bash "$DETECT" --json
  else
    echo '{"engine":"none","status":"missing","base_url":""}'
  fi
}

rt_get() {
  python3 -c "import json,sys; print(json.loads(sys.argv[1]).get(sys.argv[2],'') or '')" "$1" "$2"
}

ft_bin() {
  if have ft; then echo ft
  elif have freetoken; then echo freetoken
  else echo ft
  fi
}

ft_recorded_model() {
  local f="${STATE_DIR}/ft-model" line=""
  [[ -f "$f" ]] || return 0
  IFS= read -r line <"$f" || true
  printf '%s' "$line"
}

ft_default_model() {
  local env_model recorded
  env_model="${PFY_FT_MODEL:-${LOCAL_CODER_MODEL:-${FREETOKEN_MODEL:-}}}"
  if [[ -n "$env_model" ]]; then
    printf '%s\n' "$env_model"
    return 0
  fi
  recorded="$(ft_recorded_model)"
  printf '%s\n' "$recorded"
}

record_ft_pull_model() {
  mkdir -p "$STATE_DIR"
  printf '%s\n' "$1" >"$STATE_DIR/ft-model"
}

ft_health() {
  curl -sf --max-time 2 http://127.0.0.1:1919/v1/models >/dev/null 2>&1 \
    || curl -sf --max-time 2 http://127.0.0.1:1919/health >/dev/null 2>&1
}

wait_freetoken_health() {
  local i
  for i in $(seq 1 12); do
    ft_health && return 0
    sleep 0.5
  done
  return 1
}

ensure_freetoken() {
  local bin model
  if ! have ft && ! have freetoken; then
    echo "STUB: FreeToken not on PATH. One-liner:"
    echo "  ft serve --model \$PFY_FT_MODEL"
    return 0
  fi
  bin="$(ft_bin)"
  if ft_health; then
    echo "FreeToken API healthy"
    return 0
  fi
  model="$(ft_default_model)"
  if [[ -z "$model" ]]; then
    echo "note: FreeToken has no model env (set PFY_FT_MODEL, or LOCAL_CODER_MODEL / FREETOKEN_MODEL) — honest skip"
    echo "  ft serve --model \$PFY_FT_MODEL"
    return 0
  fi
  echo "starting FreeToken in background (wait for /v1/models or /health on :1919)…"
  ("$bin" serve --model "$model" >>"$STATE_DIR/freetoken.log" 2>&1 &) || true
  if wait_freetoken_health; then
    echo "FreeToken API healthy"
  else
    echo "note: FreeToken launched but API not healthy (partial) — not fake ready"
  fi
}

ollama_health() {
  curl -sf --max-time 2 http://127.0.0.1:11434/api/tags >/dev/null 2>&1 \
    || curl -sf --max-time 2 http://127.0.0.1:11434/v1/models >/dev/null 2>&1
}

wait_ollama_health() {
  local i
  for i in $(seq 1 12); do
    ollama_health && return 0
    sleep 0.5
  done
  return 1
}

ollama_default_model() {
  echo "${PFY_OLLAMA_MODEL:-${LOCAL_CODER_MODEL:-${OLLAMA_MODEL:-}}}"
}

ollama_has_model() {
  local name="${1:-}"
  [[ -z "$name" ]] && return 1
  ollama show "$name" >/dev/null 2>&1 && return 0
  ollama list 2>/dev/null | awk -v n="$name" 'NR>1 && $1!="" && index($1,n)==1 { found=1 } END { exit !found }'
}

ollama_any_model() {
  ollama list 2>/dev/null | awk 'NR>1 && $1!="" { found=1 } END { exit !found }'
}

ensure_ollama_adapter() {
  if ! have ollama; then
    echo "STUB: ollama not on PATH. One-liner:"
    echo "  ollama serve"
    return 0
  fi
  if ollama_health; then
    echo "ollama API healthy"
  else
    echo "starting Ollama serve (wait for /api/tags or /v1/models)…"
    (ollama serve >>"$STATE_DIR/ollama.log" 2>&1 &) || true
    if wait_ollama_health; then
      echo "ollama API healthy"
    else
      echo "note: ollama serve launched but API not healthy (partial) — not fake ready"
      return 0
    fi
  fi
  local model
  model="$(ollama_default_model)"
  if [[ -n "$model" ]]; then
    if ollama_has_model "$model"; then
      echo "default model present: $model"
    else
      echo "pulling default model: $model"
      ollama pull "$model" || echo "note: ollama pull failed — honest skip"
    fi
  elif ollama_any_model; then
    echo "note: no PFY_OLLAMA_MODEL / LOCAL_CODER_MODEL — using already-installed tags"
  else
    echo "note: no PFY_OLLAMA_MODEL / LOCAL_CODER_MODEL and no models installed — honest skip"
  fi
}


llama_swap_health() {
  curl -sf --max-time 2 http://127.0.0.1:9292/v1/models >/dev/null 2>&1 \
    || curl -sf --max-time 2 http://127.0.0.1:9292/health >/dev/null 2>&1
}

wait_llama_swap_health() {
  local i
  for i in $(seq 1 12); do
    llama_swap_health && return 0
    sleep 0.5
  done
  return 1
}

ensure_llama_swap() {
  if ! have llama-swap; then
    echo "STUB: llama-swap not on PATH. One-liner:"
    echo "  llama-swap"
    return 0
  fi
  if llama_swap_health; then
    echo "llama-swap API healthy"
    return 0
  fi
  echo "starting llama-swap in background (wait for /v1/models or /health on :9292)…"
  (llama-swap >>"$STATE_DIR/llama-swap.log" 2>&1 &) || true
  if wait_llama_swap_health; then
    echo "llama-swap API healthy"
  else
    echo "note: llama-swap launched but API not healthy (partial) — not fake ready"
  fi
}

llama_server_health() {
  curl -sf --max-time 2 http://127.0.0.1:8080/v1/models >/dev/null 2>&1 \
    || curl -sf --max-time 2 http://127.0.0.1:8080/health >/dev/null 2>&1
}

wait_llama_server_health() {
  local i
  for i in $(seq 1 12); do
    llama_server_health && return 0
    sleep 0.5
  done
  return 1
}

llama_server_model_path() {
  echo "${PFY_LLAMA_MODEL:-${LOCAL_CODER_MODEL:-}}"
}

ensure_llama_server() {
  if ! have llama-server; then
    echo "STUB: llama-server not on PATH. One-liner:"
    echo "  llama-server -m \$PFY_LLAMA_MODEL --port 8080 --host 127.0.0.1"
    return 0
  fi
  if llama_server_health; then
    echo "llama-server API healthy"
    return 0
  fi
  local model
  model="$(llama_server_model_path)"
  if [[ -z "$model" || ! -f "$model" ]]; then
    echo "note: llama-server has no GGUF path (set PFY_LLAMA_MODEL or LOCAL_CODER_MODEL to an existing file) — honest skip"
    echo "  llama-server -m \$PFY_LLAMA_MODEL --port 8080 --host 127.0.0.1"
    return 0
  fi
  echo "starting llama-server in background (wait for /v1/models or /health on :8080)…"
  (llama-server -m "$model" --port 8080 --host 127.0.0.1 >>"$STATE_DIR/llama-server.log" 2>&1 &) || true
  if wait_llama_server_health; then
    echo "llama-server API healthy"
  else
    echo "note: llama-server launched but API not healthy (partial) — not fake ready"
  fi
}

print_live_models() {
  local base="${1:-}"
  echo "models:"
  if [[ -z "$base" ]]; then
    echo "  (none — no base_url)"
    return 0
  fi
  python3 - "$base" <<'PY'
import json,sys,urllib.request
base=sys.argv[1].rstrip("/")
ids=[]
seen=set()
def add(x):
    x=(x or "").strip()
    if x and x not in seen:
        seen.add(x); ids.append(x)
for path in ("/v1/models", "/api/tags"):
    try:
        req=urllib.request.Request(base+path, method="GET")
        with urllib.request.urlopen(req, timeout=2) as r:
            d=json.loads(r.read().decode() or "{}")
    except Exception:
        continue
    if not isinstance(d, dict):
        continue
    for m in d.get("data") or []:
        if isinstance(m, dict):
            add(m.get("id") or m.get("name"))
        else:
            add(str(m))
    for m in d.get("models") or []:
        if isinstance(m, dict):
            add(m.get("name") or m.get("model") or m.get("id"))
        else:
            add(str(m))
if ids:
    for i in ids:
        print("  "+i)
else:
    print("  (none — live endpoint not listing or not up)")
PY
}

print_local_usage() {
  local engine="${1:-}"
  echo "usage:"
  case "$engine" in
    ollama)
      if have ollama; then
        out="$(ollama ps 2>/dev/null || true)"
        if [[ -n "${out// }" ]]; then
          echo "$out"
        else
          echo "  (empty)"
        fi
      else
        echo "  (empty)"
      fi
      ;;
    freetoken|ft)
      local bin=""
      have ft && bin=ft
      [[ -z "$bin" ]] && have freetoken && bin=freetoken
      if [[ -n "$bin" ]]; then
        out="$("$bin" ctl 2>/dev/null || true)"
        if [[ -n "${out// }" ]]; then
          echo "$out"
        else
          echo "  (empty)"
        fi
      else
        echo "  (empty)"
      fi
      ;;
    *)
      echo "  (empty — engine does not expose usage)"
      ;;
  esac
}

detect_status() {
  local id="$1"
  local status_reg found=0 bins
  status_reg=$(python3 -c "import json; d=json.load(open('$REG')); print(next(h['status'] for h in d['harnesses'] if h['id']=='$id'))")
  bins=$(json_field detects "$id" || true)
  if [[ -n "$bins" ]]; then
    while IFS= read -r b; do
      [[ -z "$b" ]] && continue
      if [[ "$b" == "exo.sh" ]]; then
        [[ -x "$ROOT/exo.sh" || -x "$HOME/exo/exo.sh" ]] && found=1
        have exo.sh && found=1
      elif have "$b"; then
        found=1
      fi
    done <<< "$bins"
  fi
  case "$id" in
    continue)
      echo "stub"
      return
      ;;
    agent-cage)
      if [[ "$found" -eq 1 ]]; then echo "detected-stub"; else echo "stub"; fi
      return
      ;;
    freetoken|ollama|shimmy|llama-swap|llama-server|llama.cpp)
      python3 - "$(local_runtime)" "$id" "$found" <<'PY'
import json,sys
rt=json.loads(sys.argv[1]); id=sys.argv[2]; found=int(sys.argv[3])
eng=rt.get("engine","")
alias={"llama.cpp":"llama-server","llama-server":"llama.cpp","ft":"freetoken","freetoken":"ft"}
if eng==id or alias.get(eng)==id or alias.get(id)==eng:
    print(rt.get("status","missing")); sys.exit(0)
print("partial" if found else "missing")
PY
      return
      ;;
  esac
  if [[ "$status_reg" == "stub" ]]; then
    if [[ "$found" -eq 1 ]]; then echo "detected-stub"; else echo "stub"; fi
    return
  fi
  if [[ "$found" -eq 1 ]]; then echo "ready"
  else echo "missing"
  fi
}

cmd_status() {
  echo "pfy-mentat simple surface"
  echo "root: $ROOT"
  echo "active harness: $(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)"
  rt=$(local_runtime)
  python3 -c "import json,sys; d=json.loads(sys.argv[1]); print('local runtime: engine=%s status=%s base_url=%s'%(d.get('engine'),d.get('status'),d.get('base_url') or '(none)'))" "$rt"
  print_local_usage "$(rt_get "$rt" engine)"
  echo ""
  printf "%-14s %-14s %-8s %s\n" "ID" "STATUS" "ROLE" "NAME"
  printf "%-14s %-14s %-8s %s\n" "----" "------" "----" "----"
  json_field list | while IFS=$'\t' read -r id st role name; do
    live=$(detect_status "$id")
    printf "%-14s %-14s %-8s %s\n" "$id" "$live" "$role" "$name"
  done
  echo ""
  echo "next: pfy setup   |   pfy   |   pfy start grok   |   pfy harness list"
  echo "override: PFY_LOCAL_RUNTIME=freetoken|llama-swap|llama-server|ollama"
}

cmd_setup() {
  local profile="${1:-balanced}"
  echo "==> pfy setup (profile=$profile)"
  (cd "$ROOT" && make env-init)
  if [[ -f "$ROOT/.env" ]]; then
    if grep -q '^DEPLOY_PROFILE=' "$ROOT/.env" 2>/dev/null; then
      sed -i.bak "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null \
        || sed -i '' "s/^DEPLOY_PROFILE=.*/DEPLOY_PROFILE=$profile/" "$ROOT/.env" 2>/dev/null || true
    else
      echo "DEPLOY_PROFILE=$profile" >> "$ROOT/.env"
    fi
  fi
  if have grok || [[ -x "$HOME/.local/bin/grok" ]]; then
    echo "==> Grok CLI found — installing skills"
    bash "$ROOT/bootstrap/grok-cli/install.sh" || echo "warn: grok install had issues"
  else
    echo "note: Grok CLI not on PATH — install then re-run: pfy setup"
  fi
  for bin in ft freetoken llama-swap llama-server ollama shimmy; do
    if have "$bin"; then echo "==> $bin present"; fi
  done
  have ft || have freetoken || echo "note: FreeToken not installed (uv pip install \"freetoken[accel]\")"
  have docker && echo "==> Docker present" || echo "note: Docker not found — cage lab skipped"
  if [[ ! -f "$ACTIVE_FILE" ]]; then
    echo "$(json_field default)" > "$ACTIVE_FILE"
  fi
  echo ""
  cmd_status
}

cmd_harness_use() {
  local id="${1:-}"
  [[ -n "$id" ]] || die "usage: pfy harness use <id>"
  python3 -c "import json,sys; d=json.load(open('$REG')); assert any(h['id']==sys.argv[1] for h in d['harnesses'])" "$id" \
    || die "unknown harness: $id"
  echo "$id" > "$ACTIVE_FILE"
  echo "active harness → $id"
  echo "live status: $(detect_status "$id")"
}

ensure_inference() {
  local rt engine st base
  echo "==> pfy up"
  rt=$(local_runtime)
  engine=$(rt_get "$rt" engine)
  st=$(rt_get "$rt" status)
  base=$(rt_get "$rt" base_url)
  echo "detected: engine=$engine status=$st base_url=${base:-(none)}"

  if [[ "$engine" == "ollama" ]]; then
    ensure_ollama_adapter
  elif [[ "$engine" == "llama-swap" ]]; then
    ensure_llama_swap
  elif [[ "$engine" == "llama-server" || "$engine" == "llama.cpp" ]]; then
    ensure_llama_server
  elif [[ "$engine" == "freetoken" || "$engine" == "ft" ]]; then
    ensure_freetoken
  elif [[ "$st" == "ready" ]]; then
    echo "inference already up"
  elif [[ "$st" == "missing" || "$engine" == "none" || -z "$engine" ]]; then
    echo "note: no local runtime ready — install FreeToken, llama-swap, llama-server, or ollama"
  else
    case "$engine" in
      shimmy)
        echo "STUB: shimmy HTTP not up. One-liner:"
        echo "  shimmy"
        ;;
      *)
        echo "note: no local runtime ready — install FreeToken, llama-swap, llama-server, or ollama"
        ;;
    esac
  fi

  rt=$(local_runtime)
  engine=$(rt_get "$rt" engine)
  st=$(rt_get "$rt" status)
  base=$(rt_get "$rt" base_url)
  export LOCAL_OPENAI_BASE_URL="${LOCAL_OPENAI_BASE_URL:-$base}"
  echo "engine: $engine"
  echo "status: $st"
  echo "base_url: ${LOCAL_OPENAI_BASE_URL:-${base:-(none)}}"
  print_live_models "${LOCAL_OPENAI_BASE_URL:-$base}"
}

run_product_stage() {
  echo "==> env-stage (product; honest skip if a piece is missing)"
  if [[ ! -f "$ROOT/scripts/env-stage.sh" ]]; then
    echo "note: scripts/env-stage.sh missing — skip stage"
    return 0
  fi
  bash "$ROOT/scripts/env-stage.sh" || echo "note: env-stage incomplete — continuing (honest skip)"
}


cmd_env() {
  # Same path as bare ./pfy before the window. No harness exec. No native window.
  ensure_inference
  run_product_stage
}

grok_bin() {
  if have grok; then command -v grok
  elif [[ -x "$HOME/.local/bin/grok" ]]; then echo "$HOME/.local/bin/grok"
  else return 1
  fi
}

exo_bin() {
  if [[ -x "$ROOT/exo.sh" ]]; then echo "$ROOT/exo.sh"
  elif [[ -x "$HOME/exo/exo.sh" ]]; then echo "$HOME/exo/exo.sh"
  elif have exo.sh; then command -v exo.sh
  else return 1
  fi
}

print_grok_oneliner() {
  local why="${1:-missing}"
  if [[ "$why" == "unauth" ]]; then
    echo "Grok CLI present but not authenticated — not stopping the env."
    echo "  grok login"
    echo "  (or export XAI_API_KEY — credentials/2FA are owner-only)"
  else
    echo "Grok CLI missing — not stopping the env."
    echo "  curl -fsSL https://x.ai/cli/install.sh | bash"
    echo "  grok login"
  fi
}

grok_unauth() {
  local bin="${1:-}"
  [[ -n "${XAI_API_KEY:-}" ]] && return 1
  [[ -z "$bin" ]] && return 0
  local out rc=0
  out="$("$bin" whoami 2>&1)" || rc=$?
  [[ "$rc" -ne 0 ]] && return 0
  [[ -z "${out// }" ]] && return 0
  if printf '%s' "$out" | grep -qiE 'not (logged|authenticated)|please (log in|login)|grok login|unauthori[sz]ed'; then
    return 0
  fi
  return 1
}

stub_harness() {
  local id="$1"
  local issue
  issue="$(json_field github_issue "$id" 2>/dev/null || true)"
  echo "STUB harness: $id"
  if [[ -n "$issue" ]]; then
    echo "  https://github.com/themark-net/pfy-mentat/issues/${issue}"
  fi
  case "$id" in
    continue|agent-cage)
      echo "  pfy harness use grok"
      ;;
  esac
  exit 2
}

harness_attach_ready() {
  local id="$1"
  local live
  live="$(detect_status "$id")"
  [[ "$live" == "ready" ]] || return 1
  if [[ "$id" == "grok" ]]; then
    local gbin
    gbin="$(grok_bin || true)"
    if [[ -z "$gbin" ]]; then
      print_grok_oneliner missing
      return 1
    fi
    if grok_unauth "$gbin"; then
      print_grok_oneliner unauth
      return 1
    fi
  fi
  return 0
}

exec_harness() {
  local id="$1"
  local live
  live="$(detect_status "$id" 2>/dev/null || echo missing)"
  echo "==> start harness: $id (live=$live)"
  local rt engine st base
  rt=$(local_runtime)
  python3 -c "import json,sys; print('local runtime:', json.loads(sys.argv[1]))" "$rt"
  engine=$(rt_get "$rt" engine)
  st=$(rt_get "$rt" status)
  base=$(rt_get "$rt" base_url)
  export LOCAL_OPENAI_BASE_URL="${LOCAL_OPENAI_BASE_URL:-$base}"

  case "$id" in
    grok)
      local gbin
      gbin="$(grok_bin || true)"
      if [[ -z "$gbin" ]]; then
        print_grok_oneliner missing
        return 1
      fi
      if grok_unauth "$gbin"; then
        print_grok_oneliner unauth
        return 1
      fi
      exec "$gbin"
      ;;
    freetoken|ollama|shimmy|llama-swap|llama-server|llama.cpp)
      echo "inference spine: $id  LOCAL_OPENAI_BASE_URL=${LOCAL_OPENAI_BASE_URL:-}"
      if [[ "$st" != "ready" ]]; then echo "honest stub: $id not healthy"; exit 2; fi
      return 0
      ;;
    opencode)
      if have opencode || have opencode-cli; then
        local bin
        bin=$(have opencode && echo opencode || echo opencode-cli)
        export OPENCODE_SKILLS="${OPENCODE_SKILLS:-$ROOT/bootstrap/grok-cli/skills}"
        echo "OPENCODE_SKILLS=$OPENCODE_SKILLS"
        if [[ "$st" == "ready" && -n "${LOCAL_OPENAI_BASE_URL:-}" ]]; then
          export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$LOCAL_OPENAI_BASE_URL}"
          echo "model provider: OPENAI_BASE_URL=$OPENAI_BASE_URL (from local runtime)"
        else
          echo "note: local runtime not ready — OpenCode starts without a local model provider"
        fi
        exec "$bin"
      else
        stub_harness opencode
      fi
      ;;
    hermes)
      if have hermes || have hermes-agent; then
        local bin
        bin=$(have hermes && echo hermes || echo hermes-agent)
        if [[ "$st" == "ready" && -n "${LOCAL_OPENAI_BASE_URL:-}" ]]; then
          export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$LOCAL_OPENAI_BASE_URL}"
          echo "model provider: OPENAI_BASE_URL=$OPENAI_BASE_URL (from local runtime)"
        else
          echo "note: local runtime not ready — Hermes starts without a local model provider"
        fi
        echo "note: /hermes-feedback skill stays process-only (not this runtime)"
        exec "$bin"
      else
        echo "STUB harness: hermes"
        echo "  https://github.com/themark-net/pfy-mentat/issues/56"
        echo "  curl -fsSL https://hermes-agent.nousresearch.com/install.sh | bash"
        exit 2
      fi
      ;;
    claude-code)
      if have claude; then
        if [[ "$st" == "ready" && -n "${LOCAL_OPENAI_BASE_URL:-}" ]]; then
          export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$LOCAL_OPENAI_BASE_URL}"
          echo "model provider: OPENAI_BASE_URL=$OPENAI_BASE_URL (from local runtime)"
        else
          echo "note: local runtime not ready — Claude Code starts without a local model provider"
        fi
        echo "note: skills-external/claude-unified-agents is documentation only (not vendored)"
        exec claude
      else
        echo "STUB harness: claude-code"
        echo "  https://github.com/themark-net/pfy-mentat/issues/57"
        echo "  curl -fsSL https://claude.ai/install.sh | bash"
        echo "  claude   # login in the CLI; credentials/2FA are owner-only"
        exit 2
      fi
      ;;
    codex)
      if have codex; then
        if [[ "$st" == "ready" && -n "${LOCAL_OPENAI_BASE_URL:-}" ]]; then
          export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$LOCAL_OPENAI_BASE_URL}"
          echo "model provider: OPENAI_BASE_URL=$OPENAI_BASE_URL (from local runtime)"
        else
          echo "note: local runtime not ready — Codex starts without a local model provider"
        fi
        exec codex
      else
        echo "STUB harness: codex"
        echo "  https://github.com/themark-net/pfy-mentat/issues/58"
        echo "  curl -fsSL https://chatgpt.com/codex/install.sh | sh"
        echo "  codex   # login in the CLI; credentials/2FA are owner-only"
        exit 2
      fi
      ;;
    gemini)
      if have gemini || have gemini-cli; then
        local bin
        bin=$(have gemini && echo gemini || echo gemini-cli)
        if [[ "$st" == "ready" && -n "${LOCAL_OPENAI_BASE_URL:-}" ]]; then
          export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$LOCAL_OPENAI_BASE_URL}"
          echo "model provider: OPENAI_BASE_URL=$OPENAI_BASE_URL (from local runtime)"
        else
          echo "note: local runtime not ready — Gemini starts without a local model provider"
        fi
        exec "$bin"
      else
        echo "STUB harness: gemini"
        echo "  https://github.com/themark-net/pfy-mentat/issues/59"
        echo "  npm install -g @google/gemini-cli"
        echo "  gemini   # login in the CLI; credentials/2FA are owner-only"
        exit 2
      fi
      ;;
    exo)
      local ebin
      ebin="$(exo_bin || true)"
      if [[ -n "$ebin" ]]; then
        if [[ "$st" == "ready" && -n "${LOCAL_OPENAI_BASE_URL:-}" ]]; then
          export OPENAI_BASE_URL="${OPENAI_BASE_URL:-$LOCAL_OPENAI_BASE_URL}"
          echo "model provider: OPENAI_BASE_URL=$OPENAI_BASE_URL (from local runtime)"
        else
          echo "note: local runtime not ready — Exo starts without a local model provider"
        fi
        exec "$ebin"
      else
        echo "STUB harness: exo"
        echo "  https://github.com/themark-net/pfy-mentat/issues/60"
        echo "  curl -fsSL https://raw.githubusercontent.com/exoharness/exo/main/setup.sh -o setup.sh"
        echo "  bash setup.sh"
        exit 2
      fi
      ;;
    continue|agent-cage)
      stub_harness "$id"
      ;;
    *) die "unknown harness: $id" ;;
  esac
}

attach_operator_harness() {
  local requested="${1:-}"
  local preferred tried="" id
  if [[ -n "$requested" ]]; then
    preferred="$requested"
  else
    preferred="$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)"
    [[ -n "$preferred" ]] || preferred="grok"
  fi

  case "$preferred" in
    freetoken|ollama|shimmy|llama-swap|llama-server|llama.cpp)
      exec_harness "$preferred"
      return 0
      ;;
    exo)
      if [[ -n "$requested" ]]; then
        exec_harness exo || exit 2
        return 0
      fi
      ;;
    continue|agent-cage)
      stub_harness "$preferred"
      ;;
    gemini)
      if [[ -n "$requested" ]]; then
        exec_harness gemini || exit 2
        return 0
      fi
      ;;
    codex)
      if [[ -n "$requested" ]]; then
        exec_harness codex || exit 2
        return 0
      fi
      ;;
    claude-code)
      if [[ -n "$requested" ]]; then
        exec_harness claude-code || exit 2
        return 0
      fi
      ;;
    hermes)
      if [[ -n "$requested" ]]; then
        exec_harness hermes || exit 2
        return 0
      fi
      ;;
    opencode)
      if [[ -n "$requested" ]]; then
        exec_harness opencode || exit 2
        return 0
      fi
      ;;
  esac

  if [[ -n "$preferred" ]]; then
    if [[ "$preferred" == "grok" ]]; then
      local gbin
      gbin="$(grok_bin || true)"
      if [[ -n "$gbin" ]] && ! grok_unauth "$gbin"; then
        exec_harness grok
      else
        if [[ -z "$gbin" ]]; then
          print_grok_oneliner missing
        else
          print_grok_oneliner unauth
        fi
        echo "note: preferred harness 'grok' not attached — trying next ready adapter"
      fi
    elif harness_attach_ready "$preferred"; then
      exec_harness "$preferred"
    else
      echo "note: preferred harness '$preferred' not live-ready — trying next ready adapter"
    fi
    tried="$preferred"
  fi

  while IFS= read -r id; do
    [[ -z "$id" ]] && continue
    [[ "$id" == "$tried" ]] && continue
    if harness_attach_ready "$id"; then
      echo "attaching next ready adapter: $id"
      exec_harness "$id"
    fi
  done < <(json_field adapter_ids)

  echo "error: no ready harness to attach (missing harness process is not OK for start/up)"
  echo "  install/login grok, or install opencode, then re-run: ./pfy start"
  echo "  curl -fsSL https://x.ai/cli/install.sh | bash"
  echo "  grok login"
  exit 2
}

operator_bring_up() {
  ensure_inference
  run_product_stage
  attach_operator_harness "${1:-}"
}

cmd_up() { cmd_gui; }
cmd_start() {
  if [[ -n "${1:-}" ]]; then
    operator_bring_up "$1"
  else
    cmd_gui
  fi
}

lab_stage() {
  echo "lab: optional personal cage lab (doctor → setup → up-mcp)"
  echo "lab: not product-ready; do not sell cage"
  if ! have docker; then
    echo "lab: Docker is missing"
    echo "lab: lab skipped (not product-ready)"
    echo "lab: basic ./pfy setup and ./pfy start do not require Docker"
    return 0
  fi
  local target
  for target in cage-doctor cage-setup cage-up-mcp; do
    echo "lab: running make $target"
    if ! (cd "$ROOT" && make "$target"); then
      echo "lab: step failed: $target (make $target) — not fake ready"
      return 1
    fi
  done
  echo "lab: make cage-doctor, cage-setup, cage-up-mcp completed"
}

cmd_stage() {
  if [[ "${1:-}" == "--lab" ]]; then
    lab_stage
  else
    (cd "$ROOT" && make env-stage)
  fi
}
cmd_eval() { (cd "$ROOT" && REASON="${REASON:-pfy eval}" make eval-integration-change); }
cmd_ship() { (cd "$ROOT" && make product-ship); }
cmd_models_pull() {
  local m="${1:-}" rt engine
  [[ -n "$m" ]] || die "usage: pfy models pull <name>"
  rt=$(local_runtime)
  engine=$(rt_get "$rt" engine)
  echo "engine: ${engine:-(none)}"

  ft_record_pull() {
    record_ft_pull_model "$m"
    echo "recorded FreeToken model: $m"
    echo "  next ./pfy / ./pfy up will: ft serve --model $m"
    echo "  (HF/path load happens at serve; no ft pull)"
  }

  case "$engine" in
    ollama)
      if have ollama; then
        ollama pull "$m"
      else
        echo "STUB: ollama not on PATH — honest skip"
        echo "  https://github.com/themark-net/pfy-mentat/issues/112"
        echo "  ollama pull $m"
      fi
      return 0
      ;;
    freetoken|ft)
      ft_record_pull
      return 0
      ;;
    llama-swap|llama-server|llama.cpp)
      echo "note: $engine has no pull — honest skip (no GGUF download)"
      echo "  https://github.com/themark-net/pfy-mentat/issues/112"
      echo "  set PFY_LLAMA_MODEL to an existing GGUF path"
      return 0
      ;;
    shimmy)
      echo "STUB: shimmy has no pull — honest skip"
      echo "  https://github.com/themark-net/pfy-mentat/issues/112"
      echo "  shimmy"
      return 0
      ;;
  esac

  if have ft || have freetoken; then
    ft_record_pull
    return 0
  fi
  if have ollama; then
    ollama pull "$m"
    return 0
  fi
  echo "note: no local engine to pull — honest skip"
  echo "  https://github.com/themark-net/pfy-mentat/issues/112"
  echo "  ft serve --model \$PFY_FT_MODEL"
  echo "  ollama pull $m"
  return 0
}

cmd_models_list() {
  local rt engine base
  rt=$(local_runtime)
  engine=$(rt_get "$rt" engine)
  base=$(rt_get "$rt" base_url)
  echo "engine: $engine"
  echo "base_url: ${base:-(none)}"
  print_live_models "$base"
  print_local_usage "$engine"
}

record_verb() {
  mkdir -p "$STATE_DIR"
  {
    printf 'verb: %s\n' "$*"
    printf 'when: %s\n' "$(date -u +%Y-%m-%dT%H:%M:%SZ)"
  } > "$STATE_DIR/last-verb"
}

cmd_board() {
  [[ -f "$ROOT/scripts/pfy-board.py" ]] || die "scripts/pfy-board.py missing"
  local open_flag=0
  local -a args=()
  local a
  for a in "$@"; do
    if [[ "$a" == "--open" ]]; then
      open_flag=1
    else
      args+=("$a")
    fi
  done
  if [[ "$open_flag" -eq 1 ]]; then
    echo "note: --open is a hatch; native window is the main path"
    open_board_url || true
    if [[ ${#args[@]} -gt 0 ]]; then
      exec python3 "$ROOT/scripts/pfy-board.py" "${args[@]}"
    else
      exec python3 "$ROOT/scripts/pfy-board.py"
    fi
  fi
  launch_native_gui
}

main() {
  local cmd="${1:-gui}"
  shift || true
  if [[ "$cmd" != "help" && "$cmd" != "-h" && "$cmd" != "--help" ]]; then
    record_verb "$cmd" "$@"
  fi
  case "$cmd" in
    help|-h|--help) usage ;;
    gui|"") cmd_gui ;;
    setup) cmd_setup "${1:-balanced}" ;;
    status) cmd_status ;;
    board) cmd_board "$@" ;;
    up) cmd_up ;;
    harness)
      local sub="${1:-list}"; shift || true
      case "$sub" in
        list) json_field list | column -t -s $'\t' 2>/dev/null || json_field list ;;
        use) cmd_harness_use "$@" ;;
        show) json_field get "${1:-$(cat "$ACTIVE_FILE" 2>/dev/null || json_field default)}" ;;
        *) die "harness subcommands: list|use|show" ;;
      esac
      ;;
    start) cmd_start "$@" ;;
    stage) cmd_stage "$@" ;;
    env|launch-env) cmd_env ;;
    eval) cmd_eval ;;
    ship) cmd_ship ;;
    models)
      local sub="${1:-list}"; shift || true
      case "$sub" in
        list|"") cmd_models_list ;;
        pull) cmd_models_pull "$@" ;;
        *) die "models subcommands: list|pull" ;;
      esac
      ;;
    *) usage; die "unknown command: $cmd" ;;
  esac
}

main "$@"
