#!/usr/bin/env bash
# scripts/pfy — expands #161 operator surface from scripts/pfy.payload.b64.* (gzip+base64).
set -euo pipefail
DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
BODY="$DIR/.pfy.expanded.sh"
cat "$DIR"/pfy.payload.b64.* | tr -d '\n' | base64 -d | gzip -dc >"$BODY"
chmod +x "$BODY"
exec bash "$BODY" "$@"
